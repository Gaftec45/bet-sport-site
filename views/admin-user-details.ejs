<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - BetSports</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #111827;
        }

        .admin-header {
            background: #111827;
            color: white;
            padding: 18px 30px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            gap: 20px;
        }

        .brand h1 {
            margin: 0;
            font-size: 22px;
        }

        .brand span {
            display: block;
            margin-top: 4px;
            color: #9ca3af;
            font-size: 12px;
        }

        .actions {
            display: flex;
            gap: 10px;
        }

        .actions a {
            color: white;
            text-decoration: none;

            padding: 9px 14px;

            border: 1px solid rgba(255,255,255,.2);

            border-radius: 8px;

            font-size: 13px;
        }

        .actions a:hover {
            background: rgba(255,255,255,.08);
        }

        .container {
            max-width: 1050px;

            margin: auto;

            padding: 30px 20px 50px;
        }

        .back {
            display: inline-block;

            margin-bottom: 20px;

            color: #374151;

            text-decoration: none;

            font-size: 14px;

            font-weight: 700;
        }

        .page-header {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 20px;

            margin-bottom: 25px;
        }

        .page-header h2 {
            margin: 0 0 7px;

            font-size: 28px;
        }

        .page-header p {
            margin: 0;

            color: #6b7280;

            font-size: 14px;
        }

        .wallet-button {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding: 11px 16px;

            background: #111827;

            color: white;

            text-decoration: none;

            border-radius: 9px;

            font-size: 13px;

            font-weight: 700;
        }

        .wallet-button:hover {
            background: #1f2937;
        }

        .grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;

            margin-bottom: 20px;
        }

        .card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 14px;

            overflow: hidden;
        }

        .card-title {
            padding: 18px 20px;

            border-bottom: 1px solid #e5e7eb;

            font-size: 17px;

            font-weight: 800;
        }

        .card-body {
            padding: 20px;
        }

        .info {
            display: flex;

            justify-content: space-between;

            gap: 20px;

            padding: 12px 0;

            border-bottom: 1px solid #f0f0f0;
        }

        .info:first-child {
            padding-top: 0;
        }

        .info:last-child {
            border-bottom: none;

            padding-bottom: 0;
        }

        .label {
            color: #6b7280;

            font-size: 13px;
        }

        .value {
            text-align: right;

            font-size: 14px;

            font-weight: 700;

            word-break: break-word;
        }

        .balance {
            font-size: 22px;

            font-weight: 900;
        }

        .stats {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 12px;

            margin-bottom: 20px;
        }

        .stat {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 12px;

            padding: 18px;
        }

        .stat-label {
            color: #6b7280;

            font-size: 12px;

            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 24px;

            font-weight: 900;
        }

        .table-card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 14px;

            overflow: hidden;
        }

        .table-title {
            padding: 18px 20px;

            border-bottom: 1px solid #e5e7eb;

            display: flex;

            justify-content: space-between;

            align-items: center;
        }

        .table-title h3 {
            margin: 0;

            font-size: 17px;
        }

        .table-title span {
            color: #6b7280;

            font-size: 12px;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;

            border-collapse: collapse;

            min-width: 750px;
        }

        th {
            padding: 13px 18px;

            background: #f9fafb;

            text-align: left;

            color: #6b7280;

            font-size: 11px;

            text-transform: uppercase;
        }

        td {
            padding: 15px 18px;

            border-top: 1px solid #f0f0f0;

            font-size: 13px;
        }

        .bet-id {
            font-family: monospace;

            font-size: 11px;

            color: #6b7280;
        }

        .status {
            display: inline-block;

            padding: 6px 10px;

            border-radius: 20px;

            font-size: 10px;

            font-weight: 800;

            text-transform: uppercase;
        }

        .status.pending {
            background: #fef3c7;

            color: #92400e;
        }

        .status.won {
            background: #dcfce7;

            color: #166534;
        }

        .status.lost {
            background: #fee2e2;

            color: #991b1b;
        }

        .status.cancelled {
            background: #e5e7eb;

            color: #374151;
        }

        .view-btn {
            display: inline-block;

            padding: 7px 11px;

            border-radius: 7px;

            background: #111827;

            color: white;

            text-decoration: none;

            font-size: 11px;

            font-weight: 700;
        }

        .empty {
            padding: 45px 20px;

            text-align: center;

            color: #6b7280;

            font-size: 14px;
        }

        .bottom-actions {
            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 25px;
        }

        .bottom-actions a {
            padding: 11px 16px;

            border-radius: 9px;

            text-decoration: none;

            font-size: 13px;

            font-weight: 700;
        }

        .secondary {
            background: white;

            color: #374151;

            border: 1px solid #d1d5db;
        }

        .primary {
            background: #111827;

            color: white;
        }


        @media (max-width: 750px) {

            .grid {
                grid-template-columns: 1fr;
            }

            .stats {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }


        @media (max-width: 600px) {

            .admin-header {
                padding: 15px;
            }

            .container {
                padding: 20px 12px 40px;
            }

            .page-header {
                flex-direction: column;
            }

            .page-header h2 {
                font-size: 23px;
            }

            .wallet-button {
                width: 100%;
            }

            .info {
                flex-direction: column;

                gap: 5px;
            }

            .value {
                text-align: left;
            }

            .bottom-actions {
                flex-direction: column;
            }

            .bottom-actions a {
                width: 100%;

                text-align: center;
            }

        }

    </style>

</head>


<body>


<header class="admin-header">


    <div class="brand">

        <h1>
            BetSports
        </h1>

        <span>
            Administration Panel
        </span>

    </div>


    <div class="actions">

        <a href="/admin">
            Dashboard
        </a>

        <a href="/admin/users">
            Users
        </a>

        <a href="/admin/bets">
            Bets
        </a>

        <a href="/admin/logout">
            Logout
        </a>

    </div>


</header>


<main class="container">


    <a
        href="/admin/users"
        class="back"
    >
        ← Back to Users
    </a>


    <div class="page-header">


        <div>

            <h2>
                <%= user.name %>
            </h2>

            <p>
                User account information and betting history.
            </p>

        </div>


        <a
            href="/admin/users/<%= user._id %>/wallet"
            class="wallet-button"
        >
            Manage Wallet
        </a>


    </div>


    <!-- USER + BETTING INFORMATION -->

    <div class="grid">


        <div class="card">


            <div class="card-title">

                Account Information

            </div>


            <div class="card-body">


                <div class="info">

                    <div class="label">
                        Name
                    </div>

                    <div class="value">
                        <%= user.name %>
                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Email
                    </div>

                    <div class="value">
                        <%= user.email %>
                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Current Balance
                    </div>

                    <div class="value balance">

                        ₦<%= Number(
                            user.balance
                        ).toLocaleString() %>

                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Registered
                    </div>

                    <div class="value">

                        <%= new Date(
                            user.createdAt
                        ).toLocaleString() %>

                    </div>

                </div>


            </div>


        </div>


        <div class="card">


            <div class="card-title">

                Betting Summary

            </div>


            <div class="card-body">


                <div class="info">

                    <div class="label">
                        Total Bets
                    </div>

                    <div class="value">
                        <%= totalBets %>
                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Won Bets
                    </div>

                    <div class="value">
                        <%= wonBets %>
                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Lost Bets
                    </div>

                    <div class="value">
                        <%= lostBets %>
                    </div>

                </div>


                <div class="info">

                    <div class="label">
                        Pending Bets
                    </div>

                    <div class="value">
                        <%= pendingBets %>
                    </div>

                </div>


            </div>


        </div>


    </div>


    <!-- STAT CARDS -->

    <div class="stats">


        <div class="stat">

            <div class="stat-label">
                Total Bets
            </div>

            <div class="stat-value">
                <%= totalBets %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Won
            </div>

            <div class="stat-value">
                <%= wonBets %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Lost
            </div>

            <div class="stat-value">
                <%= lostBets %>
            </div>

        </div>


        <div class="stat">

            <div class="stat-label">
                Pending
            </div>

            <div class="stat-value">
                <%= pendingBets %>
            </div>

        </div>


    </div>


    <!-- BETTING HISTORY -->

    <div class="table-card">


        <div class="table-title">

            <h3>
                Recent Betting History
            </h3>

            <span>
                Latest 20 bets
            </span>

        </div>


        <% if (bets.length === 0) { %>


            <div class="empty">

                This user has not placed any bets yet.

            </div>


        <% } else { %>


            <div class="table-wrapper">


                <table>


                    <thead>

                        <tr>

                            <th>
                                Bet ID
                            </th>

                            <th>
                                Stake
                            </th>

                            <th>
                                Total Odds
                            </th>

                            <th>
                                Potential Win
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Date
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        <% bets.forEach(bet => { %>


                            <tr>


                                <td>

                                    <span class="bet-id">

                                        <%= bet._id %>

                                    </span>

                                </td>


                                <td>

                                    ₦<%= Number(
                                        bet.stake
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    <%= Number(
                                        bet.totalOdds
                                    ).toFixed(2) %>

                                </td>


                                <td>

                                    ₦<%= Number(
                                        bet.potentialWin
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    <span
                                        class="status <%= bet.status %>"
                                    >

                                        <%= bet.status %>

                                    </span>

                                </td>


                                <td>

                                    <%= new Date(
                                        bet.createdAt
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    <a
                                        href="/admin/bets/<%= bet._id %>"
                                        class="view-btn"
                                    >
                                        View
                                    </a>

                                </td>


                            </tr>


                        <% }) %>


                    </tbody>


                </table>


            </div>


        <% } %>


    </div>


    <!-- BOTTOM ACTIONS -->

    <div class="bottom-actions">


        <a
            href="/admin/users"
            class="secondary"
        >
            Back to Users
        </a>


        <a
            href="/admin"
            class="primary"
        >
            Admin Dashboard
        </a>


    </div>


</main>


</body>

</html>