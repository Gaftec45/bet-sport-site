<%- include("partials/head") %>

<%- include("partials/navbar") %>

<style>
/* =========================================================
   WITHDRAWAL PAGE — PREMIUM SPORTSBOOK UI
========================================================= */

:root {
    --withdraw-bg: #f4f7f5;
    --withdraw-surface: #ffffff;
    --withdraw-surface-2: #f8faf9;

    --withdraw-green: #16a34a;
    --withdraw-green-dark: #15803d;
    --withdraw-green-light: #dcfce7;

    --withdraw-text: #111827;
    --withdraw-text-soft: #374151;
    --withdraw-muted: #6b7280;

    --withdraw-border: #e5e7eb;
    --withdraw-danger: #dc2626;
    --withdraw-danger-bg: #fef2f2;

    --withdraw-radius: 18px;
    --withdraw-shadow: 0 8px 30px rgba(15, 23, 42, 0.06);
}


/* =========================================================
   PAGE
========================================================= */

.container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 42px 0 80px;
}


/* =========================================================
   PAGE INTRO
========================================================= */

.container::before {
    display: block;

    color: var(--withdraw-green);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    margin-bottom: 7px;
}

.container::after {
    content: "";
}


/* =========================================================
   BALANCE HERO
========================================================= */

.balance-card {
    position: relative;

    overflow: hidden;

    min-height: 205px;

    padding: 30px 34px;

    border-radius: 24px;

    background:
        linear-gradient(
            135deg,
            #052e16 0%,
            #064e3b 48%,
            #047857 100%
        );

    color: #ffffff;

    box-shadow:
        0 18px 45px rgba(6, 78, 59, 0.20);

    display: flex;
    flex-direction: column;
    justify-content: center;

    margin-bottom: 24px;
}


/* decorative circles */

.balance-card::before {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    right: -90px;
    top: -130px;

    border-radius: 50%;

    background: rgba(255,255,255,0.08);
}


.balance-card::after {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: 90px;
    bottom: -120px;

    border-radius: 50%;

    background: rgba(255,255,255,0.05);
}


.balance-label {
    position: relative;
    z-index: 2;

    color: rgba(255,255,255,0.70);

    font-size: 13px;
    font-weight: 700;

    text-transform: uppercase;
    letter-spacing: 0.07em;

    margin-bottom: 10px;
}


.balance {
    position: relative;
    z-index: 2;

    font-size: clamp(32px, 5vw, 48px);

    line-height: 1;

    font-weight: 900;

    letter-spacing: -0.04em;
}


/* =========================================================
   MAIN WITHDRAWAL AREA
========================================================= */

.card {
    background: var(--withdraw-surface);

    border: 1px solid var(--withdraw-border);

    border-radius: var(--withdraw-radius);

    padding: 30px;

    box-shadow: var(--withdraw-shadow);

    margin-bottom: 24px;
}


.card h2 {
    margin: 0;

    color: var(--withdraw-text);

    font-size: 22px;
    font-weight: 850;

    letter-spacing: -0.02em;
}


.card h2::after {
    content: "Securely withdraw your available funds to your bank account.";

    display: block;

    margin-top: 7px;

    color: var(--withdraw-muted);

    font-size: 13px;
    font-weight: 500;

    letter-spacing: 0;
}


/* =========================================================
   FORM GRID
========================================================= */

.card > .form-group:first-of-type {
    margin-top: 28px;
}


.form-group {
    margin-bottom: 20px;
}


.form-group label {
    display: block;

    margin-bottom: 8px;

    color: var(--withdraw-text-soft);

    font-size: 13px;
    font-weight: 800;
}


/* =========================================================
   INPUTS
========================================================= */

.form-group input,
.form-group select {
    width: 100%;

    height: 54px;

    box-sizing: border-box;

    padding: 0 16px;

    border: 1px solid var(--withdraw-border);

    border-radius: 12px;

    background: #ffffff;

    color: var(--withdraw-text);

    font-family: inherit;

    font-size: 15px;
    font-weight: 600;

    outline: none;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}


.form-group input::placeholder {
    color: #9ca3af;
    font-weight: 500;
}


.form-group input:hover,
.form-group select:hover {
    border-color: #cbd5d1;
}


.form-group input:focus,
.form-group select:focus {
    border-color: var(--withdraw-green);

    box-shadow:
        0 0 0 4px rgba(22, 163, 74, 0.10);

    background: #ffffff;
}


/* =========================================================
   ACCOUNT NUMBER
========================================================= */

#accountNumber {
    letter-spacing: 0.08em;

    font-size: 17px;
}


/* =========================================================
   VERIFY BUTTON
========================================================= */

.verify-btn {
    width: 100%;

    height: 54px;

    border: 0;

    border-radius: 12px;

    background: #111827;

    color: #ffffff;

    font-family: inherit;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    transition:
        transform .18s ease,
        background .18s ease,
        box-shadow .18s ease;
}


.verify-btn:hover {
    background: #1f2937;

    transform: translateY(-1px);

    box-shadow:
        0 8px 20px rgba(17, 24, 39, 0.14);
}


.verify-btn:active {
    transform: translateY(0);
}


.verify-btn:disabled {
    opacity: 0.65;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;
}


/* =========================================================
   ERROR
========================================================= */

.error {
    display: none;

    margin-top: 16px;

    padding: 13px 15px;

    border: 1px solid #fecaca;

    border-radius: 11px;

    background: var(--withdraw-danger-bg);

    color: var(--withdraw-danger);

    font-size: 13px;
    font-weight: 700;

    line-height: 1.5;
}


/* =========================================================
   VERIFIED ACCOUNT
========================================================= */

.account-result {
    display: none;

    position: relative;

    margin-top: 20px;

    padding: 20px;

    border: 1px solid #bbf7d0;

    border-radius: 15px;

    background:
        linear-gradient(
            135deg,
            #f0fdf4,
            #ecfdf5
        );
}


.account-result::before {
    content: "";

    position: absolute;

    left: 0;
    top: 18px;
    bottom: 18px;

    width: 4px;

    border-radius: 0 5px 5px 0;

    background: var(--withdraw-green);
}


.account-result .verified {
    display: flex;

    align-items: center;
    gap: 8px;

    color: var(--withdraw-green-dark);

    font-size: 13px;
    font-weight: 850;

    margin-bottom: 8px;
}


.account-result .verified::before {
    content: "✓";

    display: flex;

    align-items: center;
    justify-content: center;

    width: 21px;
    height: 21px;

    border-radius: 50%;

    background: var(--withdraw-green);

    color: #ffffff;

    font-size: 12px;
}


#accountName {
    color: #166534;

    font-size: 17px;
    font-weight: 850;

    padding-left: 29px;
}


/* =========================================================
   WITHDRAW SECTION
========================================================= */

.withdraw-section {
    display: none;

    margin-top: 24px;

    padding-top: 25px;

    border-top: 1px solid var(--withdraw-border);
}


.withdraw-section::before {
    content: "Withdrawal details";

    display: block;

    color: var(--withdraw-text);

    font-size: 15px;
    font-weight: 850;

    margin-bottom: 18px;
}


/* =========================================================
   AMOUNT INPUT
========================================================= */

#amount {
    height: 62px;

    padding-left: 18px;

    border-radius: 13px;

    font-size: 22px;
    font-weight: 850;

    letter-spacing: -0.02em;
}


#amount::placeholder {
    font-size: 14px;
    font-weight: 500;

    letter-spacing: 0;
}


/* =========================================================
   WITHDRAW BUTTON
========================================================= */

.withdraw-btn {
    width: 100%;

    height: 58px;

    border: 0;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            var(--withdraw-green),
            var(--withdraw-green-dark)
        );

    color: #ffffff;

    font-family: inherit;

    font-size: 15px;
    font-weight: 850;

    cursor: pointer;

    box-shadow:
        0 10px 24px rgba(22, 163, 74, 0.20);

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        filter .18s ease;
}


.withdraw-btn:hover {
    transform: translateY(-2px);

    box-shadow:
        0 14px 30px rgba(22, 163, 74, 0.26);

    filter: brightness(1.03);
}


.withdraw-btn:active {
    transform: translateY(0);
}


.withdraw-btn:disabled {
    opacity: 0.65;

    cursor: not-allowed;

    transform: none;

    box-shadow: none;
}


/* =========================================================
   NOTE
========================================================= */

.note {
    margin-top: 14px;

    padding: 14px 16px;

    border-radius: 11px;

    background: #f8fafc;

    color: var(--withdraw-muted);

    font-size: 12px;

    line-height: 1.65;
}


.note::before {
    content: "ⓘ";

    margin-right: 7px;

    color: var(--withdraw-green);

    font-weight: 900;
}


/* =========================================================
   HISTORY
========================================================= */

.history {
    margin-top: 28px;
}


.history h2 {
    margin: 0 0 16px;

    color: var(--withdraw-text);

    font-size: 20px;
    font-weight: 850;

    letter-spacing: -0.02em;
}


.history-item {
    background: var(--withdraw-surface);

    border: 1px solid var(--withdraw-border);

    border-radius: 16px;

    padding: 20px 22px;

    margin-bottom: 12px;

    box-shadow:
        0 4px 18px rgba(15, 23, 42, 0.035);

    transition:
        border-color .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}


.history-item:hover {
    border-color: #d1d5db;

    transform: translateY(-1px);

    box-shadow:
        0 8px 25px rgba(15, 23, 42, 0.06);
}


/* =========================================================
   HISTORY TOP
========================================================= */

.history-top {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 17px;
}


.history-top .amount {
    color: var(--withdraw-text);

    font-size: 21px;
    font-weight: 900;

    letter-spacing: -0.02em;
}


/* =========================================================
   STATUS
========================================================= */

.status {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 76px;

    padding: 7px 11px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: 850;

    text-transform: capitalize;
}


.status.pending {
    background: #fff7ed;
    color: #c2410c;
}


.status.approved,
.status.success,
.status.completed {
    background: #dcfce7;
    color: #15803d;
}


.status.rejected,
.status.failed {
    background: #fee2e2;
    color: #b91c1c;
}


.status.processing {
    background: #eff6ff;
    color: #1d4ed8;
}


/* =========================================================
   HISTORY DETAILS
========================================================= */

.details {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px 20px;

    padding-top: 16px;

    border-top: 1px solid #f0f2f4;

    color: var(--withdraw-muted);

    font-size: 12px;

    line-height: 1.5;
}


.details > div {
    min-width: 0;

    overflow: hidden;

    text-overflow: ellipsis;
}


.details strong {
    color: var(--withdraw-text-soft);

    font-weight: 750;
}


/* =========================================================
   EMPTY HISTORY
========================================================= */

.history > .history-item:only-child {
    padding: 35px 20px;

    text-align: center;

    color: var(--withdraw-muted);

    font-size: 14px;

    background:
        linear-gradient(
            180deg,
            #ffffff,
            #fafafa
        );
}


.history > .history-item:only-child::before {
    content: "↗";

    display: flex;

    align-items: center;
    justify-content: center;

    width: 45px;
    height: 45px;

    margin: 0 auto 12px;

    border-radius: 50%;

    background: var(--withdraw-green-light);

    color: var(--withdraw-green-dark);

    font-size: 20px;
    font-weight: 900;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 700px) {

    .container {
        width: min(100% - 22px, 1120px);

        padding-top: 25px;
        padding-bottom: 55px;
    }


    .balance-card {
        min-height: 175px;

        padding: 25px 22px;

        border-radius: 20px;

        margin-bottom: 16px;
    }


    .balance {
        font-size: 34px;
    }


    .card {
        padding: 22px 17px;

        border-radius: 16px;
    }


    .card h2 {
        font-size: 20px;
    }


    .card h2::after {
        font-size: 12px;

        line-height: 1.5;
    }


    .form-group input,
    .form-group select {
        height: 52px;
    }


    #amount {
        height: 59px;

        font-size: 20px;
    }


    .withdraw-btn {
        height: 56px;
    }


    .history h2 {
        font-size: 19px;
    }


    .history-item {
        padding: 17px;

        border-radius: 14px;
    }


    .history-top .amount {
        font-size: 18px;
    }


    .details {
        grid-template-columns: 1fr;

        gap: 9px;
    }

}


@media (max-width: 420px) {

    .container {
        width: calc(100% - 16px);
    }


    .balance-card {
        padding: 23px 18px;
    }


    .balance {
        font-size: 30px;
    }


    .history-top {
        align-items: flex-start;
    }


    .status {
        min-width: auto;

        padding: 6px 9px;
    }

}


/* =========================================================
   REDUCED MOTION
========================================================= */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        transition: none !important;
    }

}
</style>


<div class="container">

    <!-- BALANCE -->

    <div class="balance-card">

        <div class="balance-label">
            Available Balance
        </div>

        <div class="balance">
            ₦<%= Number(currentUser.balance || 0).toLocaleString() %>
        </div>

    </div>


    <!-- WITHDRAWAL CARD -->

    <div class="card">

        <h2>
            Withdraw Funds
        </h2>


        <!-- BANK -->

        <div class="form-group">

            <label for="bank">
                Select Bank
            </label>

            <select id="bank">

                <option value="">
                    Loading banks...
                </option>

            </select>

        </div>


        <!-- ACCOUNT NUMBER -->

        <div class="form-group">

            <label for="accountNumber">
                Account Number
            </label>

            <input
                type="text"
                id="accountNumber"
                maxlength="10"
                inputmode="numeric"
                placeholder="Enter 10-digit account number"
            >

        </div>


        <!-- VERIFY -->

        <button
            type="button"
            class="verify-btn"
            id="verifyBtn"
        >
            Verify Account
        </button>


        <!-- ERROR -->

        <div
            class="error"
            id="errorMessage"
        ></div>


        <!-- VERIFIED ACCOUNT -->

        <div
            class="account-result"
            id="accountResult"
        >

            <strong class="verified">
                Account Verified
            </strong>

            <div id="accountName"></div>

        </div>


        <!-- WITHDRAW SECTION -->

        <div
            class="withdraw-section"
            id="withdrawSection"
        >

            <div class="form-group">

                <label for="amount">
                    Withdrawal Amount
                </label>

                <input
                    type="number"
                    id="amount"
                    min="100"
                    step="1"
                    placeholder="Minimum ₦100"
                >

            </div>


            <button
                type="button"
                class="withdraw-btn"
                id="withdrawBtn"
            >
                Request Withdrawal
            </button>


            <div class="note">

                Minimum withdrawal is ₦100.
                Your balance will be deducted immediately.
                If the withdrawal is rejected, the amount will be refunded.

            </div>

        </div>

    </div>


    <!-- HISTORY -->

    <div class="history">

        <h2>
            Withdrawal History
        </h2>

        <% if (withdrawals && withdrawals.length > 0) { %>

            <% withdrawals.forEach(withdrawal => { %>

                <div class="history-item">

                    <div class="history-top">

                        <div class="amount">
                            ₦<%= Number(withdrawal.amount).toLocaleString() %>
                        </div>

                        <div
                            class="status <%= withdrawal.status %>"
                        >
                            <%= withdrawal.status %>
                        </div>

                    </div>


                    <div class="details">

                        <div>
                            <strong>Bank:</strong>
                            <%= withdrawal.bankName %>
                        </div>

                        <div>
                            <strong>Account:</strong>
                            <%= withdrawal.accountNumber %>
                        </div>

                        <div>
                            <strong>Account Name:</strong>
                            <%= withdrawal.accountName %>
                        </div>

                        <div>
                            <strong>Reference:</strong>
                            <%= withdrawal.reference %>
                        </div>

                        <div>
                            <strong>Date:</strong>
                            <%= new Date(withdrawal.createdAt).toLocaleString() %>
                        </div>

                    </div>

                </div>

            <% }) %>

        <% } else { %>

            <div class="history-item">

                No withdrawals yet.

            </div>

        <% } %>

    </div>

</div>


<%- include("partials/footer") %>


<script>

    const bankSelect =
        document.getElementById("bank");

    const accountNumberInput =
        document.getElementById("accountNumber");

    const verifyBtn =
        document.getElementById("verifyBtn");

    const errorMessage =
        document.getElementById("errorMessage");

    const accountResult =
        document.getElementById("accountResult");

    const accountName =
        document.getElementById("accountName");

    const withdrawSection =
        document.getElementById("withdrawSection");

    const amountInput =
        document.getElementById("amount");

    const withdrawBtn =
        document.getElementById("withdrawBtn");


    let verifiedAccount = null;


    // ===============================
    // LOAD BANKS
    // ===============================

    async function loadBanks() {

        try {

            const response =
                await fetch(
                    "/api/paystack/banks"
                );

            const data =
                await response.json();

            if (!data.success) {

                throw new Error(
                    data.message ||
                    "Unable to load banks."
                );

            }

            bankSelect.innerHTML =
                '<option value="">Select your bank</option>';


            data.banks.forEach(bank => {

                const option =
                    document.createElement("option");

                option.value = bank.code;

                option.textContent =
                    bank.name;

                option.dataset.name =
                    bank.name;

                bankSelect.appendChild(option);

            });

        } catch (error) {

            bankSelect.innerHTML =
                '<option value="">Unable to load banks</option>';

            showError(error.message);

        }

    }


    // ===============================
    // VERIFY ACCOUNT
    // ===============================

    verifyBtn.addEventListener(
        "click",
        async function () {

            hideError();

            accountResult.style.display =
                "none";

            withdrawSection.style.display =
                "none";

            verifiedAccount = null;


            const bankCode =
                bankSelect.value;

            const accountNumber =
                accountNumberInput.value.trim();


            if (!bankCode) {

                showError(
                    "Please select your bank."
                );

                return;
            }


            if (!/^\d{10}$/.test(accountNumber)) {

                showError(
                    "Account number must be exactly 10 digits."
                );

                return;
            }


            verifyBtn.disabled = true;

            verifyBtn.textContent =
                "Verifying...";


            try {

                const response =
                    await fetch(
                        `/api/paystack/resolve-account?accountNumber=${encodeURIComponent(accountNumber)}&bankCode=${encodeURIComponent(bankCode)}`
                    );


                const data =
                    await response.json();


                if (
                    !response.ok ||
                    !data.success
                ) {

                    throw new Error(
                        data.message ||
                        "Unable to verify account."
                    );

                }


                verifiedAccount =
                    data.account;


                accountName.textContent =
                    data.account.accountName;


                accountResult.style.display =
                    "block";


                withdrawSection.style.display =
                    "block";


            } catch (error) {

                showError(
                    error.message
                );

            } finally {

                verifyBtn.disabled =
                    false;

                verifyBtn.textContent =
                    "Verify Account";

            }

        }
    );


    // ===============================
    // REQUEST WITHDRAWAL
    // ===============================

    withdrawBtn.addEventListener(
        "click",
        async function () {

            hideError();


            if (!verifiedAccount) {

                showError(
                    "Please verify your bank account first."
                );

                return;
            }


            const amount =
                Number(
                    amountInput.value
                );


            if (!amount || amount < 100) {

                showError(
                    "Minimum withdrawal is ₦100."
                );

                return;
            }


            withdrawBtn.disabled =
                true;

            withdrawBtn.textContent =
                "Submitting...";


            try {

                const form =
                    document.createElement("form");

                form.method =
                    "POST";

                form.action =
                    "/withdraw";


                const fields = {

                    amount:
                        amount,

                    bankName:
                        bankSelect.options[
                            bankSelect.selectedIndex
                        ].dataset.name,

                    bankCode:
                        verifiedAccount.bankCode,

                    accountNumber:
                        verifiedAccount.accountNumber,

                    accountName:
                        verifiedAccount.accountName

                };


                Object.keys(fields).forEach(
                    key => {

                        const input =
                            document.createElement(
                                "input"
                            );

                        input.type =
                            "hidden";

                        input.name =
                            key;

                        input.value =
                            fields[key];

                        form.appendChild(
                            input
                        );

                    }
                );


                document.body.appendChild(
                    form
                );

                form.submit();


            } catch (error) {

                showError(
                    error.message
                );

                withdrawBtn.disabled =
                    false;

                withdrawBtn.textContent =
                    "Request Withdrawal";

            }

        }
    );


    // ===============================
    // ERROR FUNCTIONS
    // ===============================

    function showError(message) {

        errorMessage.textContent =
            message;

        errorMessage.style.display =
            "block";

    }


    function hideError() {

        errorMessage.textContent =
            "";

        errorMessage.style.display =
            "none";

    }


    // LOAD BANKS
    loadBanks();

</script>