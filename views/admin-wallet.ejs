<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - BetSports</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #111827;
        }

        .header {
            background: #111827;
            color: white;
            padding: 18px 30px;

            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .brand h1 {
            margin: 0;
            font-size: 22px;
        }

        .brand span {
            display: block;
            margin-top: 4px;
            color: #9ca3af;
            font-size: 12px;
        }

        .nav {
            display: flex;
            gap: 10px;
        }

        .nav a {
            color: white;
            text-decoration: none;
            padding: 9px 14px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 8px;
            font-size: 13px;
        }

        .container {
            max-width: 1050px;
            margin: auto;
            padding: 30px 20px 50px;
        }

        .back {
            display: inline-block;
            margin-bottom: 20px;
            color: #374151;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
        }

        .title {
            margin-bottom: 25px;
        }

        .title h2 {
            margin: 0 0 7px;
            font-size: 28px;
        }

        .title p {
            margin: 0;
            color: #6b7280;
            font-size: 14px;
        }

        .wallet-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .user-name {
            font-size: 18px;
            font-weight: 800;
        }

        .user-email {
            margin-top: 5px;
            color: #6b7280;
            font-size: 13px;
        }

        .balance {
            margin-top: 20px;
            font-size: 32px;
            font-weight: 900;
        }

        .balance-label {
            color: #6b7280;
            font-size: 12px;
            margin-bottom: 5px;
        }

        .actions {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 20px;
        }

        .action-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            padding: 20px;
        }

        .action-card h3 {
            margin: 0 0 7px;
            font-size: 17px;
        }

        .action-card p {
            margin: 0 0 18px;
            color: #6b7280;
            font-size: 12px;
        }

        .form-group {
            margin-bottom: 12px;
        }

        .form-group label {
            display: block;
            margin-bottom: 6px;
            color: #6b7280;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .form-group input {
            width: 100%;
            padding: 11px 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

        .form-group input:focus {
            border-color: #111827;
        }

        .credit-btn,
        .debit-btn {
            width: 100%;
            border: none;
            padding: 12px;
            border-radius: 8px;
            color: white;
            font-weight: 700;
            cursor: pointer;
        }

        .credit-btn {
            background: #166534;
        }

        .debit-btn {
            background: #991b1b;
        }

        .transactions {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            overflow: hidden;
        }

        .transactions-header {
            padding: 18px 20px;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 800;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            min-width: 750px;
        }

        th {
            padding: 13px 18px;
            background: #f9fafb;
            text-align: left;
            color: #6b7280;
            font-size: 11px;
            text-transform: uppercase;
        }

        td {
            padding: 15px 18px;
            border-top: 1px solid #f0f0f0;
            font-size: 13px;
        }

        .type {
            font-weight: 800;
        }

        .credit {
            color: #15803d;
        }

        .debit {
            color: #dc2626;
        }

        .reference {
            font-family: monospace;
            font-size: 11px;
            color: #6b7280;
        }

        .empty {
            padding: 40px;
            text-align: center;
            color: #6b7280;
        }

        @media (max-width: 700px) {

            .actions {
                grid-template-columns: 1fr;
            }

            .header {
                padding: 15px;
            }

            .container {
                padding: 20px 12px 40px;
            }

            .title h2 {
                font-size: 23px;
            }

        }

    </style>

</head>


<body>


<header class="header">

    <div class="brand">

        <h1>BetSports</h1>

        <span>
            Administration Panel
        </span>

    </div>


    <nav class="nav">

        <a href="/admin">
            Dashboard
        </a>

        <a href="/admin/users">
            Users
        </a>

        <a href="/admin/logout">
            Logout
        </a>

    </nav>

</header>


<main class="container">


    <a
        href="/admin/users/<%= user._id %>"
        class="back"
    >
        ← Back to User
    </a>


    <div class="title">

        <h2>
            Wallet Management
        </h2>

        <p>
            Manage this user's wallet and review transactions.
        </p>

    </div>


    <div class="wallet-card">

        <div class="user-name">
            <%= user.name %>
        </div>

        <div class="user-email">
            <%= user.email %>
        </div>


        <div class="balance-label">
            Current Balance
        </div>

        <div class="balance">

            ₦<%= Number(
                user.balance
            ).toLocaleString() %>

        </div>

    </div>


    <div class="actions">


        <!-- CREDIT -->

        <div class="action-card">

            <h3>
                Credit Wallet
            </h3>

            <p>
                Add money to this user's wallet.
            </p>


            <form
                action="/admin/users/<%= user._id %>/wallet/credit"
                method="POST"
                onsubmit="return confirm('Credit this user wallet?');"
            >

                <div class="form-group">

                    <label>
                        Amount
                    </label>

                    <input
                        type="number"
                        name="amount"
                        min="1"
                        step="0.01"
                        placeholder="1000"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Description
                    </label>

                    <input
                        type="text"
                        name="description"
                        placeholder="Manual deposit"
                    >

                </div>


                <button
                    type="submit"
                    class="credit-btn"
                >
                    Credit Wallet
                </button>

            </form>

        </div>


        <!-- DEBIT -->

        <div class="action-card">

            <h3>
                Debit Wallet
            </h3>

            <p>
                Remove money from this user's wallet.
            </p>


            <form
                action="/admin/users/<%= user._id %>/wallet/debit"
                method="POST"
                onsubmit="return confirm('Debit this user wallet?');"
            >

                <div class="form-group">

                    <label>
                        Amount
                    </label>

                    <input
                        type="number"
                        name="amount"
                        min="1"
                        step="0.01"
                        placeholder="1000"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Description
                    </label>

                    <input
                        type="text"
                        name="description"
                        placeholder="Manual adjustment"
                    >

                </div>


                <button
                    type="submit"
                    class="debit-btn"
                >
                    Debit Wallet
                </button>

            </form>

        </div>

    </div>


    <div class="transactions">

        <div class="transactions-header">
            Transaction History
        </div>


        <% if (transactions.length === 0) { %>

            <div class="empty">
                No transactions yet.
            </div>

        <% } else { %>

            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Type
                            </th>

                            <th>
                                Amount
                            </th>

                            <th>
                                Before
                            </th>

                            <th>
                                After
                            </th>

                            <th>
                                Description
                            </th>

                            <th>
                                Reference
                            </th>

                            <th>
                                Date
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% transactions.forEach(transaction => { %>

                            <tr>

                                <td>

                                    <span
                                        class="type
                                        <%= [
                                            'deposit',
                                            'bet_win',
                                            'admin_credit'
                                        ].includes(transaction.type)
                                            ? 'credit'
                                            : 'debit'
                                        %>"
                                    >

                                        <%= transaction.type %>

                                    </span>

                                </td>


                                <td>

                                    ₦<%= Number(
                                        transaction.amount
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    ₦<%= Number(
                                        transaction.balanceBefore
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    ₦<%= Number(
                                        transaction.balanceAfter
                                    ).toLocaleString() %>

                                </td>


                                <td>

                                    <%= transaction.description || "-" %>

                                </td>


                                <td>

                                    <span class="reference">

                                        <%= transaction.reference || "-" %>

                                    </span>

                                </td>


                                <td>

                                    <%= new Date(
                                        transaction.createdAt
                                    ).toLocaleString() %>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </div>


</main>

</body>

</html>