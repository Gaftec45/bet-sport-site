<style>
/* =========================================================
   BET SLIP
   ========================================================= */

.bet-slip {
    --bet-green: #16a34a;
    --bet-green-light: #22c55e;
    --bet-green-soft: #dcfce7;
    --bet-dark: #111827;
    --bet-muted: #6b7280;
    --bet-border: #e5e7eb;

    position: fixed;
    right: 24px;
    bottom: 24px;

    width: 370px;
    max-width: calc(100vw - 32px);

    background: #ffffff;
    border: 1px solid var(--bet-border);
    border-radius: 18px;

    box-shadow:
        0 20px 60px rgba(0, 0, 0, 0.18),
        0 5px 15px rgba(0, 0, 0, 0.06);

    overflow: hidden;
    z-index: 1000;

    /* CLOSED STATE */
    transform: translateY(calc(100% + 40px));
    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        transform 0.3s ease,
        opacity 0.25s ease,
        visibility 0.3s ease;
}


/* OPEN */

.bet-slip.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}


/* =========================================================
   FLOATING OPEN BUTTON
   ========================================================= */

.bet-slip-toggle {
    position: fixed;
    right: 24px;
    bottom: 24px;

    min-width: 150px;
    height: 52px;

    padding: 0 18px;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    border: none;
    border-radius: 14px;

    background: linear-gradient(
        135deg,
        #22c55e,
        #16a34a
    );

    color: #ffffff;

    font-size: 14px;
    font-weight: 800;

    cursor: pointer;

    box-shadow:
        0 12px 30px rgba(22, 163, 74, 0.28);

    z-index: 999;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.bet-slip-toggle:hover {
    transform: translateY(-2px);

    box-shadow:
        0 16px 35px rgba(22, 163, 74, 0.35);
}

.bet-slip-toggle:active {
    transform: translateY(0);
}


/* Hide toggle while slip is open */

.bet-slip-toggle.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(20px);
}


/* =========================================================
   TOGGLE ICON
   ========================================================= */

.bet-slip-toggle-icon {
    font-size: 20px;
    line-height: 1;
}

.bet-slip-count {
    min-width: 22px;
    height: 22px;

    padding: 0 6px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #ffffff;
    color: var(--bet-green);

    font-size: 11px;
    font-weight: 900;
}


/* =========================================================
   HEADER
   ========================================================= */

.bet-slip-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 17px 18px;

    border-bottom: 1px solid var(--bet-border);

    background: #ffffff;
}

.bet-slip-heading {
    display: flex;
    align-items: center;
    gap: 11px;
}

.bet-slip-heading-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: var(--bet-green-soft);

    font-size: 19px;
}

.bet-slip-heading-text {
    display: flex;
    flex-direction: column;
}

.bet-slip-heading-text h3 {
    margin: 0;

    color: var(--bet-dark);

    font-size: 17px;
    line-height: 1.2;
    font-weight: 800;
}

.bet-slip-heading-text span {
    margin-top: 3px;

    color: var(--bet-muted);

    font-size: 11px;
    font-weight: 600;
}


/* =========================================================
   HEADER ACTIONS
   ========================================================= */

.bet-slip-actions {
    display: flex;
    align-items: center;
    gap: 5px;
}

.clear-bets,
.close-bet-slip {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 8px;

    background: transparent;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}

.clear-bets {
    color: #ef4444;

    font-size: 12px;
    font-weight: 700;
}

.clear-bets:hover {
    background: #fef2f2;
}

.close-bet-slip {
    color: #6b7280;

    font-size: 20px;
}

.close-bet-slip:hover {
    background: #f3f4f6;
    color: #111827;
}


/* =========================================================
   TABS
   ========================================================= */

.bet-slip-tabs {
    display: flex;

    height: 46px;

    border-bottom: 1px solid var(--bet-border);

    background: #ffffff;
}

.bet-tab {
    position: relative;

    flex: 1;

    border: none;
    background: transparent;

    color: #6b7280;

    cursor: pointer;

    font-size: 13px;
    font-weight: 700;

    transition: color 0.2s ease;
}

.bet-tab:hover {
    color: #111827;
}

.bet-tab.active {
    color: var(--bet-green);
}

.bet-tab.active::after {
    content: "";

    position: absolute;

    left: 20%;
    right: 20%;
    bottom: -1px;

    height: 3px;

    border-radius: 3px 3px 0 0;

    background: var(--bet-green-light);
}


/* =========================================================
   CONTENT
   ========================================================= */

.bet-slip-content {
    max-height: 340px;

    overflow-y: auto;

    scrollbar-width: thin;
}

.bet-slip-content::-webkit-scrollbar {
    width: 5px;
}

.bet-slip-content::-webkit-scrollbar-thumb {
    background: #d1d5db;
    border-radius: 10px;
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.empty-bet-slip {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    text-align: center;

    min-height: 260px;

    padding: 30px 25px;
}

.empty-bet-icon {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 15px;

    border-radius: 50%;

    background: #f0fdf4;

    font-size: 27px;
}

.empty-bet-slip h4 {
    margin: 0 0 7px;

    color: var(--bet-dark);

    font-size: 15px;
    font-weight: 800;
}

.empty-bet-slip p {
    max-width: 220px;

    margin: 0;

    color: var(--bet-muted);

    font-size: 12px;
    line-height: 1.6;
}


/* =========================================================
   SELECTIONS
   ========================================================= */

.bet-selections {
    padding: 12px;
}

.bet-selection {
    position: relative;

    padding: 13px;

    margin-bottom: 9px;

    border: 1px solid #e5e7eb;
    border-radius: 11px;

    background: #f9fafb;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.bet-selection:hover {
    border-color: #bbf7d0;

    box-shadow:
        0 5px 15px rgba(0, 0, 0, 0.04);
}

.bet-selection:last-child {
    margin-bottom: 0;
}

.bet-selection-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 10px;
}

.bet-selection-teams {
    color: #111827;

    font-size: 12px;
    line-height: 1.5;
    font-weight: 800;
}

.remove-selection {
    flex-shrink: 0;

    width: 24px;
    height: 24px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: none;
    border-radius: 6px;

    background: transparent;

    color: #9ca3af;

    cursor: pointer;

    font-size: 16px;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}

.remove-selection:hover {
    background: #fef2f2;
    color: #ef4444;
}

.bet-selection-market {
    margin-top: 7px;

    color: #6b7280;

    font-size: 11px;
    font-weight: 500;
}

.bet-selection-odd {
    display: inline-flex;
    align-items: center;

    margin-top: 9px;

    padding: 5px 9px;

    border: 1px solid #bbf7d0;
    border-radius: 6px;

    background: #f0fdf4;

    color: #15803d;

    font-size: 12px;
    font-weight: 800;
}


/* =========================================================
   FOOTER
   ========================================================= */

.bet-slip-footer {
    padding: 15px 17px 17px;

    border-top: 1px solid var(--bet-border);

    background: #f9fafb;
}


/* =========================================================
   STAKE
   ========================================================= */

.stake-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 13px;

    color: #374151;

    font-size: 13px;
    font-weight: 700;
}

.stake-input-wrapper {
    display: flex;
    align-items: center;

    width: 145px;

    border: 1px solid #d1d5db;
    border-radius: 9px;

    background: #ffffff;

    overflow: hidden;

    transition: border-color 0.2s ease,
                box-shadow 0.2s ease;
}

.stake-input-wrapper:focus-within {
    border-color: var(--bet-green);

    box-shadow:
        0 0 0 3px rgba(34, 197, 94, 0.12);
}

.stake-input-wrapper span {
    padding-left: 11px;

    color: #6b7280;

    font-size: 13px;
    font-weight: 800;
}

.stake-input-wrapper input {
    width: 100%;

    padding: 10px 10px 10px 5px;

    border: none;
    outline: none;

    background: transparent;

    color: #111827;

    font-size: 13px;
    font-weight: 700;
}


/* =========================================================
   SUMMARY
   ========================================================= */

.summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 9px;

    color: #6b7280;

    font-size: 13px;
}

.summary-row strong {
    color: #111827;

    font-size: 13px;
    font-weight: 800;
}

.potential-row {
    margin-top: 3px;
    margin-bottom: 15px;

    padding-top: 10px;

    border-top: 1px dashed #d1d5db;

    font-size: 14px;
}

.potential-row span {
    color: #374151;

    font-weight: 700;
}

.potential-row strong {
    color: var(--bet-green);

    font-size: 17px;
}


/* =========================================================
   PLACE BET
   ========================================================= */

.place-bet-btn {
    width: 100%;

    min-height: 47px;

    padding: 12px 15px;

    border: none;
    border-radius: 10px;

    background: linear-gradient(
        135deg,
        #22c55e,
        #16a34a
    );

    color: #ffffff;

    cursor: pointer;

    font-size: 13px;
    font-weight: 800;

    box-shadow:
        0 7px 18px rgba(22, 163, 74, 0.20);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

.place-bet-btn:hover {
    transform: translateY(-1px);

    box-shadow:
        0 10px 24px rgba(22, 163, 74, 0.28);
}

.place-bet-btn:active {
    transform: translateY(0);
}

.place-bet-btn:disabled {
    background: #d1d5db;

    color: #6b7280;

    cursor: not-allowed;

    box-shadow: none;

    transform: none;
}


/* =========================================================
   MOBILE BACKDROP
   ========================================================= */

.bet-slip-backdrop {
    position: fixed;

    inset: 0;

    background: rgba(15, 23, 42, 0.45);

    backdrop-filter: blur(2px);

    z-index: 998;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
        opacity 0.3s ease,
        visibility 0.3s ease;
}

.bet-slip-backdrop.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

    .bet-slip {
        right: 16px;
        bottom: 16px;

        width: 350px;
    }

    .bet-slip-toggle {
        right: 16px;
        bottom: 16px;
    }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

    .bet-slip {
        left: 0;
        right: 0;
        bottom: 0;

        width: 100%;
        max-width: none;

        border-radius: 20px 20px 0 0;

        border-left: none;
        border-right: none;
        border-bottom: none;

        box-shadow:
            0 -10px 40px rgba(0, 0, 0, 0.18);

        transform: translateY(100%);
    }

    .bet-slip.is-open {
        transform: translateY(0);
    }


    .bet-slip-toggle {
        left: 15px;
        right: 15px;
        bottom: 15px;

        width: auto;

        border-radius: 13px;
    }


    .bet-slip-content {
        max-height: 38vh;
    }


    .empty-bet-slip {
        min-height: 210px;
    }


    .bet-slip-footer {
        padding-bottom:
            calc(15px + env(safe-area-inset-bottom));
    }

}


/* =========================================================
   SMALL PHONES
   ========================================================= */

@media (max-width: 380px) {

    .bet-slip-header {
        padding: 14px;
    }

    .bet-slip-heading-icon {
        width: 34px;
        height: 34px;
    }

    .bet-slip-heading-text h3 {
        font-size: 15px;
    }

    .stake-input-wrapper {
        width: 130px;
    }

    .bet-slip-content {
        max-height: 35vh;
    }

}
</style>


<!-- =======================================================
     BACKDROP
     ======================================================= -->

<div
    class="bet-slip-backdrop"
    id="bet-slip-backdrop"
></div>


<!-- =======================================================
     OPEN BET SLIP BUTTON
     ======================================================= -->

<button
    type="button"
    class="bet-slip-toggle"
    id="bet-slip-toggle"
    aria-label="Open bet slip"
    aria-controls="bet-slip"
    aria-expanded="false"
>

    <span class="bet-slip-toggle-icon">
        🎟️
    </span>

    <span>
        Bet Slip
    </span>

    <span
        class="bet-slip-count"
        id="bet-slip-count"
    >
        0
    </span>

</button>


<!-- =======================================================
     BET SLIP
     ======================================================= -->

<aside
    class="bet-slip"
    id="bet-slip"
    aria-hidden="true"
>

    <!-- HEADER -->

    <div class="bet-slip-header">

        <div class="bet-slip-heading">

            <div class="bet-slip-heading-icon">
                🎟️
            </div>

            <div class="bet-slip-heading-text">

                <h3>
                    Bet Slip
                </h3>

                <span id="bet-slip-selected-text">
                    No games selected
                </span>
            </div>

        </div>


        <div class="bet-slip-actions">

            <button
                type="button"
                class="clear-bets"
                id="clear-bets"
            >
                Clear
            </button>

            <button
                type="button"
                class="close-bet-slip"
                id="close-bet-slip"
                aria-label="Close bet slip"
            >
                ×
            </button>

        </div>

    </div>


    <!-- TABS -->

    <div class="bet-slip-tabs">

        <button
            type="button"
            class="bet-tab active"
            data-tab="bets"
        >
            Bets
        </button>

        <button
            type="button"
            class="bet-tab"
            data-tab="open"
        >
            Open Bets
        </button>

    </div>


    <!-- CONTENT -->

    <div
        class="bet-slip-content"
        id="bet-slip-content"
    >

        <div
            class="empty-bet-slip"
            id="empty-bet-slip"
        >

            <div class="empty-bet-icon">
                🎟️
            </div>

            <h4>
                Your bet slip is empty
            </h4>

            <p>
                Click on any odds to add a selection.
            </p>

        </div>


        <div
            class="bet-selections"
            id="bet-selections"
        ></div>

    </div>


    <!-- FOOTER -->

    <div
        class="bet-slip-footer"
        id="bet-slip-footer"
    >

        <div class="stake-row">

            <span>
                Stake
            </span>

            <div class="stake-input-wrapper">

                <span>
                    ₦
                </span>

                <input
                    type="number"
                    id="stake-input"
                    placeholder="0"
                    min="0"
                    step="100"
                    inputmode="numeric"
                >

            </div>

        </div>


        <div class="summary-row">

            <span>
                Total Odds
            </span>

            <strong id="total-odds">
                0.00
            </strong>

        </div>


        <div class="summary-row potential-row">

            <span>
                Potential Win
            </span>

            <strong id="potential-win">
                ₦0.00
            </strong>

        </div>


        <button
            type="button"
            class="place-bet-btn"
            id="place-bet-btn"
        >
            Place Bet
        </button>

    </div>

</aside>


<script>
/* =========================================================
   BET SLIP OPEN / CLOSE
   ========================================================= */

const betSlip = document.getElementById("bet-slip");
const betSlipToggle = document.getElementById("bet-slip-toggle");
const closeBetSlip = document.getElementById("close-bet-slip");
const betSlipBackdrop = document.getElementById("bet-slip-backdrop");


function openBetSlip() {

    betSlip.classList.add("is-open");

    betSlipToggle.classList.add("hidden");

    betSlipBackdrop.classList.add("is-visible");

    betSlip.setAttribute("aria-hidden", "false");

    betSlipToggle.setAttribute("aria-expanded", "true");

}


function closeBetSlipPanel() {

    betSlip.classList.remove("is-open");

    betSlipToggle.classList.remove("hidden");

    betSlipBackdrop.classList.remove("is-visible");

    betSlip.setAttribute("aria-hidden", "true");

    betSlipToggle.setAttribute("aria-expanded", "false");

}


/* OPEN */

betSlipToggle.addEventListener(
    "click",
    openBetSlip
);


/* CLOSE */

closeBetSlip.addEventListener(
    "click",
    closeBetSlipPanel
);


/* CLOSE WHEN CLICKING BACKDROP */

betSlipBackdrop.addEventListener(
    "click",
    closeBetSlipPanel
);


/* ESC KEY */

document.addEventListener(
    "keydown",
    function (event) {

        if (
            event.key === "Escape" &&
            betSlip.classList.contains("is-open")
        ) {

            closeBetSlipPanel();

        }

    }
);


/* =========================================================
   UPDATE BET COUNT
   ========================================================= */

function updateBetSlipCount() {

    const selections =
        document.querySelectorAll(
            ".bet-selection"
        );

    const count =
        selections.length;

    const countElement =
        document.getElementById(
            "bet-slip-count"
        );

    if (countElement) {

        countElement.textContent = count;

    }

}


/* =========================================================
   AUTO OPEN WHEN A BET IS ADDED
   ========================================================= */

function openBetSlipWhenSelectionAdded() {

    updateBetSlipCount();

    openBetSlip();

}


/* =========================================================
   WATCH FOR NEW BET SELECTIONS
   ========================================================= */

const selectionsContainer =
    document.getElementById(
        "bet-selections"
    );


if (selectionsContainer) {

    const observer =
        new MutationObserver(
            function () {

                updateBetSlipCount();

            }
        );

    observer.observe(
        selectionsContainer,
        {
            childList: true,
            subtree: true
        }
    );

}


/* INITIAL COUNT */

updateBetSlipCount();


/* =========================================================
   CLEAR BETS
   ========================================================= */

const clearBets =
    document.getElementById(
        "clear-bets"
    );

if (clearBets) {

    clearBets.addEventListener(
        "click",
        function () {

            /*
             * Your existing clear-bets
             * logic should run here.
             *
             * If you already have a listener
             * for #clear-bets elsewhere,
             * keep that listener.
             */

            updateBetSlipCount();

        }
    );

}
</script>