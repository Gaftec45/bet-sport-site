<style>
    /* =========================================================
   UPCOMING GAMES — MODERN SPORTSBOOK CARDS
========================================================= */

.upcoming-section {
    position: relative;
    background: #f5f7fa;
    padding: 78px 0 90px;
}


/* =========================================================
   SECTION HEADER
========================================================= */

.upcoming-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 30px;
}

.section-heading {
    max-width: 680px;
}

.section-heading .section-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 10px;
    color: #16a34a;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.7px;
}

.section-heading .section-label::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 5px rgba(34, 197, 94, 0.10);
}

.section-heading h2 {
    margin: 0;
    color: #0f172a;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.08;
    font-weight: 850;
    letter-spacing: -1.2px;
}

.section-heading p {
    margin: 11px 0 0;
    max-width: 570px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
}


/* =========================================================
   VIEW ALL
========================================================= */

.view-all-games {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    min-height: 42px;
    padding: 0 16px;

    color: #334155;
    background: #ffffff;

    border: 1px solid #e2e8f0;
    border-radius: 10px;

    font-size: 13px;
    font-weight: 750;
    text-decoration: none;

    box-shadow: 0 2px 5px rgba(15, 23, 42, 0.03);

    transition:
        color .2s ease,
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
}

.view-all-games span {
    font-size: 17px;
    transition: transform .2s ease;
}

.view-all-games:hover {
    color: #15803d;
    border-color: #bbf7d0;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
    transform: translateY(-1px);
}

.view-all-games:hover span {
    transform: translateX(4px);
}


/* =========================================================
   GAME LIST
========================================================= */

.upcoming-games-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}


/* =========================================================
   GAME CARD
========================================================= */

.upcoming-games-list .game-card {
    position: relative;

    display: flex;
    flex-direction: column;

    padding: 18px;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 16px;

    box-shadow:
        0 1px 2px rgba(15, 23, 42, 0.03),
        0 5px 18px rgba(15, 23, 42, 0.035);

    overflow: hidden;

    transition:
        transform .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
}

.upcoming-games-list .game-card:hover {
    transform: translateY(-3px);

    border-color: #d5dce5;

    box-shadow:
        0 12px 30px rgba(15, 23, 42, 0.08);
}


/* =========================================================
   TOP MATCH INFO
========================================================= */

.upcoming-games-list .game-date {
    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;

    margin-bottom: 20px;

    color: #64748b;

    font-size: 11px;
    font-weight: 700;
}

.upcoming-games-list .game-date::before {
    content: "UPCOMING";

    display: inline-flex;
    align-items: center;

    min-height: 24px;

    padding: 0 9px;

    color: #15803d;
    background: #f0fdf4;

    border: 1px solid #dcfce7;
    border-radius: 6px;

    font-size: 8px;
    font-weight: 850;

    letter-spacing: 1px;
}


/* =========================================================
   TEAM AREA
========================================================= */

.upcoming-games-list .game-teams {
    display: grid;

    grid-template-columns: minmax(0, 1fr) 55px minmax(0, 1fr);

    align-items: center;

    width: 100%;

    gap: 10px;

    text-align: center;

    padding: 4px 5px 20px;
}


/* =========================================================
   TEAM NAMES
========================================================= */

.upcoming-games-list .game-teams strong {
    display: block;

    color: #172033;

    font-size: 14px;
    font-weight: 750;

    line-height: 1.35;

    overflow-wrap: anywhere;
}


/* =========================================================
   VS
========================================================= */

.upcoming-games-list .game-teams span {
    display: flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    margin: auto;

    color: #64748b;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 50%;

    font-size: 9px;
    font-weight: 850;

    letter-spacing: .5px;
}


/* =========================================================
   ODDS AREA
========================================================= */

.upcoming-games-list .odds {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 7px;

    width: 100%;

    padding-top: 15px;

    border-top: 1px solid #eef1f4;
}


/* =========================================================
   ODDS BUTTON
========================================================= */

.upcoming-games-list .odd-button {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;
    min-height: 48px;

    padding: 7px 10px;

    color: #64748b;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 9px;

    font-size: 10px;
    font-weight: 650;

    cursor: pointer;

    transition:
        background .18s ease,
        border-color .18s ease,
        color .18s ease,
        box-shadow .18s ease,
        transform .15s ease;
}

.upcoming-games-list .odd-button strong {
    color: #172033;

    font-size: 13px;
    font-weight: 850;

    white-space: nowrap;
}


/* =========================================================
   ODDS HOVER
========================================================= */

.upcoming-games-list .odd-button:hover {
    color: #15803d;

    background: #f0fdf4;

    border-color: #86efac;

    box-shadow:
        0 4px 12px rgba(34, 197, 94, 0.10);
}

.upcoming-games-list .odd-button:hover strong {
    color: #15803d;
}

.upcoming-games-list .odd-button:active {
    transform: scale(.97);
}


/* =========================================================
   SELECTED ODDS
========================================================= */

.upcoming-games-list .odd-button.selected {
    color: #ffffff;

    background: #16a34a;

    border-color: #16a34a;

    box-shadow:
        0 5px 15px rgba(22, 163, 74, 0.22);
}

.upcoming-games-list .odd-button.selected strong {
    color: #ffffff;
}


/* =========================================================
   SELECTED CHECK
========================================================= */

.upcoming-games-list .odd-button.selected::after {
    content: "✓";

    position: absolute;

    top: -6px;
    right: -6px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 17px;
    height: 17px;

    color: #ffffff;

    background: #15803d;

    border: 2px solid #ffffff;

    border-radius: 50%;

    font-size: 9px;
    font-weight: 900;
}


/* =========================================================
   DISABLED
========================================================= */

.upcoming-games-list .odd-button:disabled {
    cursor: not-allowed;

    color: #cbd5e1;

    background: #f8fafc;

    border-color: #edf0f3;

    opacity: .65;
}

.upcoming-games-list .odd-button:disabled strong {
    color: #cbd5e1;
}


/* =========================================================
   LOADING
========================================================= */

.loading-card {
    overflow: hidden;
}

.loading-skeleton {
    background:
        linear-gradient(
            90deg,
            #f1f5f9 25%,
            #e2e8f0 50%,
            #f1f5f9 75%
        );

    background-size: 200% 100%;

    animation: skeletonLoading 1.5s infinite;
}

.loading-date {
    width: 90px;
    height: 22px;
    border-radius: 6px;
}

.loading-match {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
}

.loading-team {
    display: flex;
    align-items: center;
    gap: 10px;
}

.loading-logo {
    width: 42px;
    height: 42px;
    border-radius: 50%;
}

.loading-name {
    width: 90px;
    height: 12px;
    border-radius: 5px;
}

.loading-vs {
    width: 34px;
    height: 34px;
    border-radius: 50%;
}

@keyframes skeletonLoading {
    0% {
        background-position: 200% 0;
    }

    100% {
        background-position: -200% 0;
    }
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

    .upcoming-games-list {
        grid-template-columns: 1fr;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .upcoming-section {
        padding: 52px 0 65px;
    }

    .upcoming-header {
        align-items: flex-start;
        flex-direction: column;
        gap: 16px;
    }

    .view-all-games {
        width: 100%;
        min-height: 44px;
    }

    .upcoming-games-list {
        gap: 12px;
    }

    .upcoming-games-list .game-card {
        padding: 15px;

        border-radius: 14px;
    }

    .upcoming-games-list .game-date {
        margin-bottom: 17px;
        font-size: 10px;
    }

    .upcoming-games-list .game-date::before {
        min-height: 22px;
        padding: 0 8px;
        font-size: 7px;
    }

    .upcoming-games-list .game-teams {
        grid-template-columns:
            minmax(0, 1fr)
            42px
            minmax(0, 1fr);

        gap: 6px;

        padding-bottom: 17px;
    }

    .upcoming-games-list .game-teams strong {
        font-size: 12px;
    }

    .upcoming-games-list .game-teams span {
        width: 32px;
        height: 32px;
        font-size: 8px;
    }

    .upcoming-games-list .odds {
        gap: 5px;
        padding-top: 12px;
    }

    .upcoming-games-list .odd-button {
        min-height: 48px;

        flex-direction: column;
        justify-content: center;

        gap: 3px;

        padding: 5px 4px;

        border-radius: 8px;

        font-size: 8px;
    }

    .upcoming-games-list .odd-button strong {
        font-size: 12px;
    }

}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .upcoming-games-list .game-card {
        padding: 13px;
    }

    .upcoming-games-list .game-teams strong {
        font-size: 11px;
    }

    .upcoming-games-list .game-teams span {
        width: 29px;
        height: 29px;
    }

    .upcoming-games-list .odd-button {
        min-height: 45px;
        font-size: 7px;
    }

    .upcoming-games-list .odd-button strong {
        font-size: 11px;
    }

}
</style>

<section class="section section-light upcoming-section">

    <div class="container">

        <div class="section-header upcoming-header">

            <div class="section-heading">

                <span class="section-label">
                    UPCOMING
                </span>

                <h2>Upcoming games</h2>

                <p>
                    Choose your odds and place your bets before kickoff.
                </p>

            </div>

            <a href="#upcoming-games-list" class="view-all-games">
                View all
                <span>→</span>
            </a>

        </div>


        <div class="games-list upcoming-games-list"
             id="upcoming-games-list">

            <div class="game-card loading-card">

                <div class="game-info">

                    <div class="loading-skeleton loading-date"></div>

                    <div class="loading-match">

                        <div class="loading-team">

                            <div class="loading-logo"></div>

                            <div class="loading-name"></div>

                        </div>

                        <div class="loading-vs"></div>

                        <div class="loading-team">

                            <div class="loading-logo"></div>

                            <div class="loading-name"></div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>