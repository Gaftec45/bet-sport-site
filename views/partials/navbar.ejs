<style>
    /* =========================
   NAVBAR
========================= */

.navbar {
    background: #0b1220;
    color: #fff;
    padding: 14px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar-inner {
    display: flex;
    align-items: center;
    min-height: 48px;
}


/* LOGO */

.logo {
    display: flex;
    align-items: center;
    gap: 3px;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -0.8px;
    color: #fff;
    text-decoration: none;
}

.logo span {
    color: #22c55e;
}


/* NAV LINKS */

.nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 48px;
}

.nav-links a {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    color: #aeb8c7;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
}

.nav-links a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
}

.nav-links a.active {
    color: #22c55e;
    background: rgba(34, 197, 94, 0.10);
}


/* NAV ACTIONS */

.nav-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
}


/* LOGIN */

.login-btn {
    padding: 10px 17px;
    border-radius: 8px;
    color: #d1d5db;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
}

.login-btn:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
}


/* REGISTER */

.register-btn {
    padding: 10px 18px;
    border-radius: 8px;
    background: #22c55e;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.20);
    transition: all 0.2s ease;
}

.register-btn:hover {
    background: #16a34a;
    transform: translateY(-1px);
}


/* =========================
   LOGGED-IN NAVBAR
========================= */

.user-balance {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    padding: 7px 12px;
    margin-right: 2px;
    line-height: 1.2;
    text-decoration: none;
    border-radius: 8px;
    transition: background 0.2s ease;
}

.user-balance:hover {
    background: rgba(255, 255, 255, 0.05);
}

.nav-user-name {
    font-size: 12px;
    font-weight: 700;
    color: #e5e7eb;
}

.nav-balance {
    font-size: 13px;
    font-weight: 800;
    color: #22c55e;
    margin-top: 3px;
}


/* DASHBOARD */

.dashboard-btn {
    padding: 10px 16px;
    border-radius: 8px;
    background: #22c55e;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.16);
    transition: all 0.2s ease;
}

.dashboard-btn:hover {
    background: #16a34a;
    transform: translateY(-1px);
}


/* LOGOUT */

.logout-btn {
    padding: 10px 15px;
    border-radius: 8px;
    border: 1px solid #273244;
    background: transparent;
    color: #aeb8c7;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
}

.logout-btn:hover {
    color: #fff;
    background: #151e2d;
    border-color: #374151;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 800px) {

    .navbar {
        padding: 12px 0;
    }

    .nav-links {
        display: none;
    }

    .logo {
        font-size: 22px;
    }

    .nav-actions {
        gap: 6px;
    }

    .user-balance {
        display: none;
    }

    .dashboard-btn {
        padding: 9px 12px;
        font-size: 13px;
    }

    .logout-btn {
        padding: 9px 11px;
        font-size: 13px;
    }

    .login-btn {
        padding: 9px 11px;
        font-size: 13px;
    }

    .register-btn {
        padding: 9px 13px;
        font-size: 13px;
    }
}


@media (max-width: 450px) {

    .logo {
        font-size: 20px;
    }

    .logout-btn {
        display: none;
    }

    .dashboard-btn {
        padding: 9px 10px;
    }

    .register-btn {
        padding: 9px 11px;
    }
}
</style>

<header class="navbar">

    <div class="container navbar-inner">

        <a href="/" class="logo">
            Bet<span>Sports</span>
        </a>

        <nav class="nav-links">

            <a href="/">
                🏠 Home
            </a>

            <a href="/sports">
                ⚽ Sports
            </a>

            <a href="/#live-games-list">
                🔴 Live
            </a>

            <a href="/virtuals">
                🎮 Virtual
            </a>

        </nav>


        <div class="nav-actions">

            <% if (isLoggedIn && currentUser) { %>

                <a href="/dashboard" class="user-balance">

                    <span class="nav-user-name">
                        <%= currentUser.name.split(" ")[0] %>
                    </span>

                    <span class="nav-balance">
                        ₦<%= currentUser.balance.toLocaleString() %>
                    </span>

                </a>


                <a href="/dashboard" class="dashboard-btn">
                    Dashboard
                </a>


                <a href="/logout" class="logout-btn">
                    Logout
                </a>

            <% } else { %>

                <a href="/login" class="login-btn">
                    Login
                </a>

                <a href="/register" class="register-btn">
                    Register
                </a>

            <% } %>

        </div>

    </div>

</header>