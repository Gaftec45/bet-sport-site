<style>

/* =========================================================
   LIVE GAMES — PREMIUM SPORTSBOOK CARDS
========================================================= */

.section {
    position: relative;

    background: #f5f7fa;

    padding: 78px 0 90px;
}


/* =========================================================
   SECTION HEADER
========================================================= */

.section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    gap: 30px;

    margin-bottom: 30px;
}


/* =========================================================
   SECTION HEADING
========================================================= */

.section-header > div {
    max-width: 680px;
}


/* =========================================================
   LIVE LABEL
========================================================= */

.section-header .section-label {
    display: inline-flex;
    align-items: center;

    gap: 9px;

    margin-bottom: 10px;

    color: #dc2626;

    font-size: 11px;
    font-weight: 800;

    letter-spacing: 1.7px;

    line-height: 1;
}


/* Live indicator */

.section-header .section-label::before {
    content: "";

    width: 7px;
    height: 7px;

    flex-shrink: 0;

    border-radius: 50%;

    background: #ef4444;

    box-shadow:
        0 0 0 5px rgba(239, 68, 68, .10);

    animation: livePulse 1.8s ease-in-out infinite;
}


/* =========================================================
   LIVE PULSE
========================================================= */

@keyframes livePulse {

    0%,
    100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: .45;
        transform: scale(.75);
    }

}


/* =========================================================
   SECTION TITLE
========================================================= */

.section-header h2 {
    margin: 0;

    color: #0f172a;

    font-size: clamp(30px, 4vw, 40px);

    line-height: 1.08;

    font-weight: 850;

    letter-spacing: -1.2px;
}


/* =========================================================
   VIEW ALL
========================================================= */

.section-header > a {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 9px;

    min-height: 42px;

    padding: 0 16px;

    color: #334155;

    background: #ffffff;

    border: 1px solid #e2e8f0;

    border-radius: 10px;

    font-size: 13px;

    font-weight: 750;

    text-decoration: none;

    box-shadow:
        0 2px 5px rgba(15, 23, 42, .03);

    transition:
        color .2s ease,
        border-color .2s ease,
        box-shadow .2s ease,
        transform .2s ease;
}


/* =========================================================
   VIEW ALL HOVER
========================================================= */

.section-header > a:hover {
    color: #dc2626;

    border-color: #fecaca;

    box-shadow:
        0 6px 18px rgba(15, 23, 42, .06);

    transform: translateY(-1px);
}


/* =========================================================
   GAMES LIST
========================================================= */

.games-list {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 16px;
}


/* =========================================================
   GAME CARD
========================================================= */

.games-list .game-card {
    position: relative;

    display: flex;

    flex-direction: column;

    padding: 18px;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    box-shadow:
        0 1px 2px rgba(15, 23, 42, .03),
        0 5px 18px rgba(15, 23, 42, .035);

    overflow: hidden;

    transition:
        transform .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
}


/* =========================================================
   LIVE CARD TOP ACCENT
========================================================= */

.games-list .game-cardd::before {
    content: "";

    position: absolute;

    top: 0;

    left: 0;

    right: 0;

    height: 2px;

    background: #ef4444;

    opacity: .85;
}


/* =========================================================
   CARD HOVER
========================================================= */

.games-list .game-card:hover {
    transform: translateY(-3px);

    border-color: #d5dce5;

    box-shadow:
        0 12px 30px rgba(15, 23, 42, .08);
}


/* =========================================================
   GAME INFO
========================================================= */

.games-list .game-info {
    display: flex;

    flex-direction: column;

    align-items: center;

    width: 100%;

    min-height: 150px;

    padding: 0;
}


/* =========================================================
   GAME DATE / LIVE STATUS
========================================================= */

.games-list .game-date {
    display: flex;

    align-items: center;

    justify-content: space-between;

    width: 100%;

    margin-bottom: 20px;

    color: #64748b;

    font-size: 11px;

    font-weight: 700;
}


/* LIVE badge */

.games-list .game-date::before {
    content: "LIVE";

    display: inline-flex;

    align-items: center;

    min-height: 24px;

    padding: 0 9px;

    color: #dc2626;

    background: #fef2f2;

    border: 1px solid #fee2e2;

    border-radius: 6px;

    font-size: 8px;

    font-weight: 850;

    letter-spacing: 1px;
}


/* =========================================================
   TEAM AREA
========================================================= */

.games-list .game-teams {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        55px
        minmax(0, 1fr);

    align-items: center;

    width: 100%;

    gap: 10px;

    text-align: center;

    padding: 4px 5px 20px;
}


/* =========================================================
   TEAM NAMES
========================================================= */

.games-list .game-teams strong {
    display: block;

    color: #172033;

    font-size: 14px;

    font-weight: 750;

    line-height: 1.35;

    overflow-wrap: anywhere;
}


/* =========================================================
   VS BADGE
========================================================= */

.games-list .game-teams span {
    display: flex;

    align-items: center;

    justify-content: center;

    width: 38px;

    height: 38px;

    margin: auto;

    color: #64748b;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 50%;

    font-size: 9px;

    font-weight: 850;

    letter-spacing: .5px;
}


/* =========================================================
   ODDS AREA
========================================================= */

.games-list .odds {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 7px;

    width: 100%;

    padding-top: 15px;

    border-top: 1px solid #eef1f4;
}


/* =========================================================
   ODDS BUTTON
========================================================= */

.games-list .odd-button {
    position: relative;

    display: flex;

    align-items: center;

    justify-content: space-between;

    width: 100%;

    min-height: 48px;

    padding: 7px 10px;

    color: #64748b;

    background: #f8fafc;

    border: 1px solid #e2e8f0;

    border-radius: 9px;

    font-size: 10px;

    font-weight: 650;

    cursor: pointer;

    transition:
        background .18s ease,
        border-color .18s ease,
        color .18s ease,
        box-shadow .18s ease,
        transform .15s ease;
}


/* =========================================================
   ODDS VALUE
========================================================= */

.games-list .odd-button strong {
    color: #172033;

    font-size: 13px;

    font-weight: 850;

    white-space: nowrap;
}


/* =========================================================
   ODDS HOVER
========================================================= */

.games-list .odd-button:hover {
    color: #dc2626;

    background: #fef2f2;

    border-color: #fca5a5;

    box-shadow:
        0 4px 12px rgba(239, 68, 68, .10);
}


.games-list .odd-button:hover strong {
    color: #dc2626;
}


/* =========================================================
   ODDS ACTIVE
========================================================= */

.games-list .odd-button:active {
    transform: scale(.97);
}


/* =========================================================
   SELECTED ODDS
========================================================= */

.games-list .odd-button.selected {
    color: #ffffff;

    background: #dc2626;

    border-color: #dc2626;

    box-shadow:
        0 5px 15px rgba(220, 38, 38, .22);
}


.games-list .odd-button.selected strong {
    color: #ffffff;
}


/* =========================================================
   SELECTED CHECK
========================================================= */

.games-list .odd-button.selected::after {
    content: "✓";

    position: absolute;

    top: -6px;

    right: -6px;

    display: flex;

    align-items: center;

    justify-content: center;

    width: 17px;

    height: 17px;

    color: #ffffff;

    background: #b91c1c;

    border: 2px solid #ffffff;

    border-radius: 50%;

    font-size: 9px;

    font-weight: 900;
}


/* =========================================================
   DISABLED ODDS
========================================================= */

.games-list .odd-button:disabled {
    cursor: not-allowed;

    color: #cbd5e1;

    background: #f8fafc;

    border-color: #edf0f3;

    opacity: .65;
}


.games-list .odd-button:disabled strong {
    color: #cbd5e1;
}


/* =========================================================
   LOADING CARD
========================================================= */

.loading-card {
    grid-column: 1 / -1;

    min-height: 120px;

    cursor: default;

    background:
        linear-gradient(
            90deg,
            #f1f5f9 25%,
            #e2e8f0 50%,
            #f1f5f9 75%
        );

    background-size: 200% 100%;

    animation:
        liveSkeletonLoading 1.5s infinite;
}


/* Don't apply normal card hover */

.loading-card:hover {
    transform: none;

    border-color: #e5e7eb;

    box-shadow:
        0 1px 2px rgba(15, 23, 42, .03),
        0 5px 18px rgba(15, 23, 42, .035);
}


/* =========================================================
   LOADING CONTENT
========================================================= */

.loading-card .game-info {
    display: flex;

    align-items: center;

    justify-content: center;

    min-height: 120px;
}


.loading-card .game-info span {
    display: flex;

    align-items: center;

    gap: 10px;

    color: #64748b;

    font-size: 13px;

    font-weight: 650;
}


/* =========================================================
   LOADING SPINNER
========================================================= */

.loading-card .game-info span::before {
    content: "";

    width: 14px;

    height: 14px;

    flex-shrink: 0;

    border: 2px solid #cbd5e1;

    border-top-color: #64748b;

    border-radius: 50%;

    animation:
        liveLoadingSpin .75s linear infinite;
}


/* =========================================================
   LOADING ANIMATIONS
========================================================= */

@keyframes liveSkeletonLoading {

    0% {
        background-position: 200% 0;
    }

    100% {
        background-position: -200% 0;
    }

}


@keyframes liveLoadingSpin {

    to {
        transform: rotate(360deg);
    }

}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 900px) {

    .games-list {
        grid-template-columns: 1fr;
    }

}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    .section {
        padding: 52px 0 65px;
    }


    .section-header {
        align-items: flex-start;

        flex-direction: column;

        gap: 16px;
    }


    .section-header > a {
        width: 100%;

        min-height: 44px;
    }


    .section-header h2 {
        font-size: 30px;
    }


    .games-list {
        gap: 12px;
    }


    .games-list .game-card {
        padding: 15px;

        border-radius: 14px;
    }


    .games-list .game-date {
        margin-bottom: 17px;

        font-size: 10px;
    }


    .games-list .game-date::before {
        min-height: 22px;

        padding: 0 8px;

        font-size: 7px;
    }


    .games-list .game-teams {
        grid-template-columns:
            minmax(0, 1fr)
            42px
            minmax(0, 1fr);

        gap: 6px;

        padding-bottom: 17px;
    }


    .games-list .game-teams strong {
        font-size: 12px;
    }


    .games-list .game-teams span {
        width: 32px;

        height: 32px;

        font-size: 8px;
    }


    .games-list .odds {
        gap: 5px;

        padding-top: 12px;
    }


    .games-list .odd-button {
        min-height: 48px;

        flex-direction: column;

        justify-content: center;

        gap: 3px;

        padding: 5px 4px;

        border-radius: 8px;

        font-size: 8px;
    }


    .games-list .odd-button strong {
        font-size: 12px;
    }

}


/* =========================================================
   SMALL PHONES
========================================================= */

@media (max-width: 380px) {

    .games-list .game-card {
        padding: 13px;
    }


    .games-list .game-teams strong {
        font-size: 11px;
    }


    .games-list .game-teams span {
        width: 29px;

        height: 29px;
    }


    .games-list .odd-button {
        min-height: 45px;

        font-size: 7px;
    }


    .games-list .odd-button strong {
        font-size: 11px;
    }

}

</style>

</style>

<section class="section">

    <div class="container">

        <div class="section-header">

            <div>
                <span class="section-label">
                    LIVE
                </span>

                <h2>Live games</h2>
            </div>

            <a href="#">
                View all →
            </a>

        </div>

        <div class="games-list" id="live-games-list">

            <div class="game-cardd loading-card">
                <div class="game-info">
                    <span>Loading live games...</span>
                </div>
            </div>

        </div>

    </div>

</section>