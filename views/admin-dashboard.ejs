<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - BetSports</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <style>

        .admin-page {
            min-height: 100vh;
            background: #f5f6f8;
        }

        .admin-header {
            background: #111827;
            color: white;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-brand h1 {
            margin: 0;
            font-size: 22px;
        }

        .admin-brand span {
            font-size: 12px;
            opacity: .7;
        }

        .admin-logout {
            color: white;
            text-decoration: none;
            padding: 9px 14px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 8px;
            font-size: 13px;
        }

        .admin-container {
            max-width: 1250px;
            margin: auto;
            padding: 30px 20px;
        }

        .admin-welcome {
            margin-bottom: 25px;
        }

        .admin-welcome h2 {
            margin: 0 0 5px;
            font-size: 28px;
        }

        .admin-welcome p {
            margin: 0;
            color: #6b7280;
        }

        .stats-grid {
            display: grid;
            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: white;
            padding: 22px;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
        }

        .stat-label {
            color: #6b7280;
            font-size: 13px;
            margin-bottom: 10px;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 800;
            color: #111827;
        }

        .stat-card.pending {
            border-left: 4px solid #f59e0b;
        }

        .stat-card.won {
            border-left: 4px solid #16a34a;
        }

        .stat-card.lost {
            border-left: 4px solid #dc2626;
        }

        .section-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            overflow: hidden;
        }

        .section-header {
            padding: 20px;
            border-bottom: 1px solid #e5e7eb;
        }

        .section-header h3 {
            margin: 0;
            font-size: 18px;
        }

        .bets-table-wrapper {
            overflow-x: auto;
        }

        .bets-table {
            width: 100%;
            border-collapse: collapse;
        }

        .bets-table th,
        .bets-table td {
            padding: 15px 20px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
        }

        .bets-table th {
            background: #f9fafb;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
        }

        .user-name {
            font-weight: 600;
        }

        .user-email {
            color: #6b7280;
            font-size: 12px;
            margin-top: 3px;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status.won {
            background: #dcfce7;
            color: #166534;
        }

        .status.lost {
            background: #fee2e2;
            color: #991b1b;
        }

        .status.cancelled {
            background: #e5e7eb;
            color: #374151;
        }

        .empty-admin {
            padding: 50px;
            text-align: center;
            color: #6b7280;
        }

        @media (max-width: 900px) {

            .stats-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .admin-header {
                padding: 15px;
            }

            .admin-container {
                padding: 20px 12px;
            }

            .admin-welcome h2 {
                font-size: 23px;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .admin-brand h1 {
                font-size: 18px;
            }

        }

    </style>

</head>

<body>

<div class="admin-page">

    <!-- HEADER -->

    <header class="admin-header">

        <div class="admin-brand">

            <h1>BetSports</h1>

            <span>
                Administration Panel
            </span>

        </div>
<div style="display:flex; gap:10px;">
    <a href="/admin/withdrawals"
    class="admin-logout"
    >
        withdraw
    </a>
        <a href="/admin/users"
    class="admin-logout"
    >
        Users
    </a>

    <a
        href="/admin/bets"
        class="admin-logout"
    >
        Manage Bets
    </a>

    <a
        href="/admin/logout"
        class="admin-logout"
    >
        Logout
    </a>

</div>

    </header>


    <!-- CONTENT -->

    <main class="admin-container">

        <div class="admin-welcome">

            <h2>Dashboard</h2>

            <p>
                Overview of your sportsbook.
            </p>

        </div>


        <!-- STATISTICS -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-label">
                    Total Users
                </div>

                <div class="stat-value">
                    <%= totalUsers %>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Total Bets
                </div>

                <div class="stat-value">
                    <%= totalBets %>
                </div>

            </div>


            <div class="stat-card pending">

                <div class="stat-label">
                    Pending Bets
                </div>

                <div class="stat-value">
                    <%= pendingBets %>
                </div>

            </div>


            <div class="stat-card won">

                <div class="stat-label">
                    Won Bets
                </div>

                <div class="stat-value">
                    <%= wonBets %>
                </div>

            </div>

        </div>


        <!-- RECENT BETS -->

        <div class="section-card">

            <div class="section-header">

                <h3>
                    Recent Bets
                </h3>

            </div>


            <% if (recentBets.length === 0) { %>

                <div class="empty-admin">

                    No bets have been placed yet.

                </div>

            <% } else { %>

                <div class="bets-table-wrapper">

                    <table class="bets-table">

                        <thead>

                            <tr>

                                <th>User</th>

                                <th>Stake</th>

                                <th>Total Odds</th>

                                <th>Potential Win</th>

                                <th>Status</th>

                                <th>Date</th>

                            </tr>

                        </thead>


                        <tbody>

                            <% recentBets.forEach(bet => { %>

                                <tr>

                                    <td>

                                        <% if (bet.user) { %>

                                            <div class="user-name">
                                                <%= bet.user.name %>
                                            </div>

                                            <div class="user-email">
                                                <%= bet.user.email %>
                                            </div>

                                        <% } else { %>

                                            Unknown User

                                        <% } %>

                                    </td>


                                    <td>
                                        ₦<%= Number(bet.stake).toLocaleString() %>
                                    </td>


                                    <td>
                                        <%= Number(bet.totalOdds).toFixed(2) %>
                                    </td>


                                    <td>
                                        ₦<%= Number(bet.potentialWin).toLocaleString() %>
                                    </td>


                                    <td>

                                        <span
                                            class="status <%= bet.status %>"
                                        >
                                            <%= bet.status %>
                                        </span>

                                    </td>


                                    <td>

                                        <%= new Date(
                                            bet.createdAt
                                        ).toLocaleString() %>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </main>

</div>

</body>

</html>