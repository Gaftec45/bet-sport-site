<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - BetSports</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f6f8;
            color: #111827;
        }

        .admin-page {
            min-height: 100vh;
        }

        /* HEADER */

        .admin-header {
            background: #111827;
            color: white;
            padding: 18px 30px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            gap: 20px;
        }

        .admin-brand h1 {
            margin: 0;
            font-size: 22px;
        }

        .admin-brand span {
            display: block;
            margin-top: 4px;
            font-size: 12px;
            color: #9ca3af;
        }

        .admin-actions {
            display: flex;
            gap: 10px;
        }

        .admin-actions a {
            color: white;
            text-decoration: none;

            padding: 9px 14px;

            border: 1px solid rgba(255,255,255,.2);

            border-radius: 8px;

            font-size: 13px;
        }

        .admin-actions a:hover {
            background: rgba(255,255,255,.08);
        }

        /* CONTAINER */

        .admin-container {
            max-width: 1050px;

            margin: auto;

            padding: 30px 20px 50px;
        }

        .back-link {
            display: inline-block;

            margin-bottom: 20px;

            color: #374151;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;
        }

        /* PAGE HEADER */

        .page-header {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 20px;

            margin-bottom: 25px;
        }

        .page-header h2 {
            margin: 0 0 7px;

            font-size: 28px;
        }

        .page-header p {
            margin: 0;

            color: #6b7280;

            font-size: 14px;
        }

        /* STATUS */

        .status {
            display: inline-flex;

            padding: 7px 13px;

            border-radius: 20px;

            font-size: 11px;

            font-weight: 800;

            text-transform: uppercase;
        }

        .status.pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status.won {
            background: #dcfce7;
            color: #166534;
        }

        .status.lost {
            background: #fee2e2;
            color: #991b1b;
        }

        .status.cancelled {
            background: #e5e7eb;
            color: #374151;
        }

        /* GRID */

        .details-grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 20px;

            margin-bottom: 20px;
        }

        /* CARD */

        .admin-card {
            background: white;

            border: 1px solid #e5e7eb;

            border-radius: 15px;

            overflow: hidden;
        }

        .card-header {
            padding: 18px 20px;

            border-bottom: 1px solid #e5e7eb;

            display: flex;

            justify-content: space-between;

            align-items: center;

            gap: 10px;
        }

        .card-header h3 {
            margin: 0;

            font-size: 17px;
        }

        .card-body {
            padding: 20px;
        }

        /* INFO */

        .info-row {
            display: flex;

            justify-content: space-between;

            gap: 20px;

            padding: 11px 0;

            border-bottom: 1px solid #f0f0f0;
        }

        .info-row:last-child {
            border-bottom: none;

            padding-bottom: 0;
        }

        .info-row:first-child {
            padding-top: 0;
        }

        .info-label {
            color: #6b7280;

            font-size: 13px;
        }

        .info-value {
            text-align: right;

            font-size: 14px;

            font-weight: 600;

            word-break: break-word;
        }

        .balance {
            font-weight: 800;
        }

        .bet-id {
            font-family: monospace;

            font-size: 12px;

            color: #374151;
        }

        /* SELECTION */

        .selection {
            padding: 20px;

            border-bottom: 1px solid #e5e7eb;
        }

        .selection:last-child {
            border-bottom: none;
        }

        .selection-top {
            display: flex;

            justify-content: space-between;

            align-items: flex-start;

            gap: 15px;

            margin-bottom: 15px;
        }

        .teams {
            font-size: 16px;

            font-weight: 700;

            line-height: 1.4;
        }

        .event-id {
            margin-top: 6px;

            font-size: 11px;

            color: #9ca3af;

            font-family: monospace;

            word-break: break-all;
        }

        .selection-details {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 12px;
        }

        .selection-box {
            background: #f9fafb;

            border: 1px solid #e5e7eb;

            border-radius: 10px;

            padding: 13px;
        }

        .selection-box-label {
            color: #6b7280;

            font-size: 11px;

            margin-bottom: 5px;

            text-transform: uppercase;

            font-weight: 700;
        }

        .selection-box-value {
            font-size: 14px;

            font-weight: 700;
        }

        .result-won {
            color: #15803d;
        }

        .result-lost {
            color: #dc2626;
        }

        .result-pending {
            color: #92400e;
        }

        /* SETTLEMENT */

        .settlement-box {
            margin-top: 18px;

            padding: 18px;

            background: #f9fafb;

            border: 1px solid #e5e7eb;

            border-radius: 12px;
        }

        .settlement-title {
            margin-bottom: 5px;

            font-size: 14px;

            font-weight: 800;
        }

        .settlement-description {
            margin: 0 0 15px;

            color: #6b7280;

            font-size: 12px;

            line-height: 1.5;
        }

        .score-form {
            display: grid;

            grid-template-columns:
                1fr 1fr auto;

            gap: 10px;

            align-items: end;
        }

        .score-field label {
            display: block;

            margin-bottom: 6px;

            font-size: 11px;

            font-weight: 700;

            color: #6b7280;

            text-transform: uppercase;
        }

        .score-field input {
            width: 100%;

            padding: 11px 12px;

            border: 1px solid #d1d5db;

            border-radius: 8px;

            font-size: 14px;

            outline: none;
        }

        .score-field input:focus {
            border-color: #111827;
        }

        .settle-btn {
            border: none;

            padding: 11px 16px;

            background: #111827;

            color: white;

            border-radius: 8px;

            font-size: 13px;

            font-weight: 700;

            cursor: pointer;
        }

        .settle-btn:hover {
            background: #1f2937;
        }

        .already-settled {
            margin-top: 15px;

            padding: 12px;

            border-radius: 8px;

            background: #f3f4f6;

            color: #6b7280;

            font-size: 12px;
        }

        /* FINANCIAL */

        .financial-grid {
            display: grid;

            grid-template-columns: repeat(3, 1fr);

            gap: 15px;
        }

        .financial-box {
            padding: 18px;

            background: #f9fafb;

            border: 1px solid #e5e7eb;

            border-radius: 12px;
        }

        .financial-label {
            color: #6b7280;

            font-size: 12px;

            margin-bottom: 8px;
        }

        .financial-value {
            font-size: 21px;

            font-weight: 800;
        }

        .payout-box {
            margin-top: 20px;

            padding: 16px;

            border-radius: 10px;

            background: #f0fdf4;

            border: 1px solid #bbf7d0;
        }

        .payout-box strong {
            color: #166534;
        }

        .payout-box span {
            color: #15803d;

            font-size: 13px;
        }

        .settled-box {
            margin-top: 20px;

            padding: 15px;

            background: #f9fafb;

            border: 1px solid #e5e7eb;

            border-radius: 10px;
        }

        .settled-box p {
            margin: 0;

            color: #6b7280;

            font-size: 13px;
        }

        /* ACTIONS */

        .bottom-actions {
            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 25px;
        }

        .action-btn {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding: 11px 17px;

            border-radius: 9px;

            text-decoration: none;

            font-size: 13px;

            font-weight: 700;
        }

        .action-btn.primary {
            background: #111827;

            color: white;
        }

        .action-btn.secondary {
            background: white;

            color: #374151;

            border: 1px solid #d1d5db;
        }

        /* MOBILE */

        @media (max-width: 800px) {

            .details-grid {
                grid-template-columns: 1fr;
            }

            .selection-details {
                grid-template-columns: repeat(2, 1fr);
            }

        }

        @media (max-width: 600px) {

            .admin-header {
                padding: 15px;
            }

            .admin-container {
                padding: 20px 12px 40px;
            }

            .page-header {
                flex-direction: column;
            }

            .page-header h2 {
                font-size: 23px;
            }

            .admin-brand h1 {
                font-size: 18px;
            }

            .selection-details {
                grid-template-columns: 1fr;
            }

            .financial-grid {
                grid-template-columns: 1fr;
            }

            .score-form {
                grid-template-columns: 1fr;
            }

            .settle-btn {
                width: 100%;
            }

            .info-row {
                flex-direction: column;

                gap: 5px;
            }

            .info-value {
                text-align: left;
            }

            .bottom-actions {
                flex-direction: column;
            }

            .action-btn {
                width: 100%;
            }

        }

    </style>

</head>


<body>

<div class="admin-page">


    <!-- HEADER -->

    <header class="admin-header">

        <div class="admin-brand">

            <h1>BetSports</h1>

            <span>
                Administration Panel
            </span>

        </div>


        <div class="admin-actions">

            <a href="/admin">
                Dashboard
            </a>

            <a href="/admin/bets">
                Bets
            </a>

            <a href="/admin/logout">
                Logout
            </a>

        </div>

    </header>


    <!-- MAIN -->

    <main class="admin-container">


        <a
            href="/admin/bets"
            class="back-link"
        >
            ← Back to Bets
        </a>


        <!-- PAGE HEADER -->

        <div class="page-header">

            <div>

                <h2>
                    Bet Details
                </h2>

                <p>
                    Review and manage this bet.
                </p>

            </div>


            <span class="status <%= bet.status %>">

                <%= bet.status %>

            </span>

        </div>


        <!-- USER + BET -->

        <div class="details-grid">


            <!-- USER -->

            <div class="admin-card">

                <div class="card-header">

                    <h3>
                        User Information
                    </h3>

                </div>


                <div class="card-body">

                    <% if (bet.user) { %>

                        <div class="info-row">

                            <div class="info-label">
                                Name
                            </div>

                            <div class="info-value">
                                <%= bet.user.name %>
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Email
                            </div>

                            <div class="info-value">
                                <%= bet.user.email %>
                            </div>

                        </div>


                        <div class="info-row">

                            <div class="info-label">
                                Current Balance
                            </div>

                            <div class="info-value balance">
                                ₦<%= Number(
                                    bet.user.balance
                                ).toLocaleString() %>
                            </div>

                        </div>

                    <% } else { %>

                        <div class="info-row">

                            <div class="info-label">
                                User
                            </div>

                            <div class="info-value">
                                Unknown User
                            </div>

                        </div>

                    <% } %>

                </div>

            </div>


            <!-- BET INFO -->

            <div class="admin-card">

                <div class="card-header">

                    <h3>
                        Bet Information
                    </h3>

                </div>


                <div class="card-body">

                    <div class="info-row">

                        <div class="info-label">
                            Bet ID
                        </div>

                        <div class="info-value bet-id">
                            <%= bet._id %>
                        </div>

                    </div>


                    <div class="info-row">

                        <div class="info-label">
                            Selections
                        </div>

                        <div class="info-value">
                            <%= bet.selections.length %>
                        </div>

                    </div>


                    <div class="info-row">

                        <div class="info-label">
                            Created
                        </div>

                        <div class="info-value">

                            <%= new Date(
                                bet.createdAt
                            ).toLocaleString() %>

                        </div>

                    </div>


                    <div class="info-row">

                        <div class="info-label">
                            Payout Processed
                        </div>

                        <div class="info-value">

                            <%= bet.payoutProcessed
                                ? "Yes"
                                : "No"
                            %>

                        </div>

                    </div>


                    <div class="info-row">

                        <div class="info-label">
                            Settled At
                        </div>

                        <div class="info-value">

                            <% if (bet.settledAt) { %>

                                <%= new Date(
                                    bet.settledAt
                                ).toLocaleString() %>

                            <% } else { %>

                                Not settled

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- SELECTIONS -->

        <div class="admin-card">

            <div class="card-header">

                <h3>
                    Selections
                </h3>

                <span>
                    <%= bet.selections.length %>
                </span>

            </div>


            <% bet.selections.forEach((selection, index) => { %>


                <div class="selection">


                    <div class="selection-top">

                        <div>

                            <div class="teams">

                                <%= selection.homeTeam %>

                                <span> vs </span>

                                <%= selection.awayTeam %>

                            </div>


                            <div class="event-id">

                                Event ID:
                                <%= selection.eventId %>

                            </div>

                        </div>


                        <span
                            class="status <%= selection.status %>"
                        >

                            <%= selection.status %>

                        </span>

                    </div>


                    <div class="selection-details">


                        <div class="selection-box">

                            <div class="selection-box-label">
                                Market
                            </div>

                            <div class="selection-box-value">
                                Match Winner
                            </div>

                        </div>


                        <div class="selection-box">

                            <div class="selection-box-label">
                                Selection
                            </div>

                            <div class="selection-box-value">

                                <%= selection.selection %>

                            </div>

                        </div>


                        <div class="selection-box">

                            <div class="selection-box-label">
                                Odds
                            </div>

                            <div class="selection-box-value">

                                <%= Number(
                                    selection.odds
                                ).toFixed(2) %>

                            </div>

                        </div>


                        <div class="selection-box">

                            <div class="selection-box-label">
                                Result
                            </div>

                            <div
                                class="selection-box-value
                                <%= selection.status === 'won'
                                    ? 'result-won'
                                    : selection.status === 'lost'
                                    ? 'result-lost'
                                    : 'result-pending'
                                %>"
                            >

                                <%= selection.result || "Pending" %>

                            </div>

                        </div>


                        <div class="selection-box">

                            <div class="selection-box-label">
                                Selection #
                            </div>

                            <div class="selection-box-value">

                                <%= index + 1 %>

                            </div>

                        </div>


                    </div>


                    <!-- SETTLEMENT -->

                    <% if (selection.status === "pending") { %>


                        <div class="settlement-box">

                            <div class="settlement-title">
                                Settle Match
                            </div>

                            <p class="settlement-description">

                                Enter the final score for this match.
                                The system will automatically determine
                                whether the user's selection won or lost.

                            </p>


                            <form
                                action="/admin/bets/<%= bet._id %>/settle"
                                method="POST"
                                class="score-form"
                            >

                                <input
                                    type="hidden"
                                    name="eventId"
                                    value="<%= selection.eventId %>"
                                >

                                <input
                                    type="hidden"
                                    name="homeTeam"
                                    value="<%= selection.homeTeam %>"
                                >

                                <input
                                    type="hidden"
                                    name="awayTeam"
                                    value="<%= selection.awayTeam %>"
                                >


                                <div class="score-field">

                                    <label>
                                        <%= selection.homeTeam %>
                                    </label>

                                    <input
                                        type="number"
                                        name="homeScore"
                                        min="0"
                                        step="1"
                                        placeholder="0"
                                        required
                                    >

                                </div>


                                <div class="score-field">

                                    <label>
                                        <%= selection.awayTeam %>
                                    </label>

                                    <input
                                        type="number"
                                        name="awayScore"
                                        min="0"
                                        step="1"
                                        placeholder="0"
                                        required
                                    >

                                </div>


                                <button
                                    type="submit"
                                    class="settle-btn"
                                    onclick="return confirm('Are you sure you want to settle this match with this score?');"
                                >
                                    Settle Match
                                </button>

                            </form>

                        </div>


                    <% } else { %>


                        <div class="already-settled">

                            This selection has already been settled.

                            Result:

                            <strong>
                                <%= selection.result || "N/A" %>
                            </strong>

                        </div>


                    <% } %>


                </div>


            <% }) %>

        </div>


        <!-- FINANCIAL SUMMARY -->

        <div class="admin-card" style="margin-top:20px;">

            <div class="card-header">

                <h3>
                    Financial Summary
                </h3>

            </div>


            <div class="card-body">

                <div class="financial-grid">


                    <div class="financial-box">

                        <div class="financial-label">
                            Stake
                        </div>

                        <div class="financial-value">

                            ₦<%= Number(
                                bet.stake
                            ).toLocaleString() %>

                        </div>

                    </div>


                    <div class="financial-box">

                        <div class="financial-label">
                            Total Odds
                        </div>

                        <div class="financial-value">

                            <%= Number(
                                bet.totalOdds
                            ).toFixed(2) %>

                        </div>

                    </div>


                    <div class="financial-box">

                        <div class="financial-label">
                            Potential Win
                        </div>

                        <div class="financial-value">

                            ₦<%= Number(
                                bet.potentialWin
                            ).toLocaleString() %>

                        </div>

                    </div>

                </div>


                <% if (
                    bet.status === "won" &&
                    bet.payoutProcessed
                ) { %>


                    <div class="payout-box">

                        <strong>
                            Payout Processed
                        </strong>

                        <br>

                        <span>

                            ₦<%= Number(
                                bet.potentialWin
                            ).toLocaleString() %>

                            has been credited to the user's balance.

                        </span>

                    </div>


                <% } %>


                <% if (bet.settledAt) { %>


                    <div class="settled-box">

                        <p>

                            This bet was settled on

                            <strong>

                                <%= new Date(
                                    bet.settledAt
                                ).toLocaleString() %>

                            </strong>.

                        </p>

                    </div>


                <% } %>


            </div>

        </div>


        <!-- ACTIONS -->

        <div class="bottom-actions">

            <a
                href="/admin/bets"
                class="action-btn secondary"
            >
                Back to Bets
            </a>


            <a
                href="/admin"
                class="action-btn primary"
            >
                Admin Dashboard
            </a>

        </div>


    </main>

</div>

</body>

</html>