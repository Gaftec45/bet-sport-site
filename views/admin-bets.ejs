<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title><%= title %> - BetSports</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>

        .admin-page {
            min-height: 100vh;
            background: #f5f6f8;
        }

        .admin-header {
            background: #111827;
            color: white;
            padding: 18px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-brand h1 {
            margin: 0;
            font-size: 22px;
        }

        .admin-brand span {
            font-size: 12px;
            opacity: .7;
        }

        .admin-actions {
            display: flex;
            gap: 10px;
        }

        .admin-actions a {
            color: white;
            text-decoration: none;
            padding: 9px 14px;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 8px;
            font-size: 13px;
        }

        .admin-container {
            max-width: 1250px;
            margin: auto;
            padding: 30px 20px;
        }

        .page-heading {
            margin-bottom: 25px;
        }

        .page-heading h2 {
            margin: 0 0 5px;
            font-size: 28px;
        }

        .page-heading p {
            margin: 0;
            color: #6b7280;
        }

        .bets-card {
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 15px;
            overflow: hidden;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 15px 18px;
            text-align: left;
            border-bottom: 1px solid #f0f0f0;
            font-size: 14px;
            white-space: nowrap;
        }

        th {
            background: #f9fafb;
            color: #6b7280;
            font-size: 12px;
            text-transform: uppercase;
        }

        .user-name {
            font-weight: 600;
        }

        .user-email {
            color: #6b7280;
            font-size: 12px;
            margin-top: 3px;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .pending {
            background: #fef3c7;
            color: #92400e;
        }

        .won {
            background: #dcfce7;
            color: #166534;
        }

        .lost {
            background: #fee2e2;
            color: #991b1b;
        }

        .cancelled {
            background: #e5e7eb;
            color: #374151;
        }

        .view-btn {
            display: inline-block;
            padding: 7px 12px;
            background: #111827;
            color: white;
            text-decoration: none;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
            color: #6b7280;
        }

        @media (max-width: 600px) {

            .admin-header {
                padding: 15px;
            }

            .admin-container {
                padding: 20px 12px;
            }

            .page-heading h2 {
                font-size: 23px;
            }

            .admin-brand h1 {
                font-size: 18px;
            }

        }

    </style>

</head>

<body>

<div class="admin-page">

    <header class="admin-header">

        <div class="admin-brand">

            <h1>BetSports</h1>

            <span>Administration Panel</span>

        </div>

        <div class="admin-actions">

            <a href="/admin">
                Dashboard
            </a>

            <a href="/admin/logout">
                Logout
            </a>

        </div>

    </header>


    <main class="admin-container">

        <div class="page-heading">

            <h2>Manage Bets</h2>

            <p>
                View and manage all sportsbook bets.
            </p>

        </div>


        <div class="bets-card">

            <% if (bets.length === 0) { %>

                <div class="empty-state">
                    No bets found.
                </div>

            <% } else { %>

                <div class="table-wrapper">

                    <table>

                        <thead>

                            <tr>

                                <th>User</th>
                                <th>Stake</th>
                                <th>Odds</th>
                                <th>Potential Win</th>
                                <th>Status</th>
                                <th>Date</th>
                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            <% bets.forEach(bet => { %>

                                <tr>

                                    <td>

                                        <% if (bet.user) { %>

                                            <div class="user-name">
                                                <%= bet.user.name %>
                                            </div>

                                            <div class="user-email">
                                                <%= bet.user.email %>
                                            </div>

                                        <% } else { %>

                                            Unknown User

                                        <% } %>

                                    </td>

                                    <td>
                                        ₦<%= Number(bet.stake).toLocaleString() %>
                                    </td>

                                    <td>
                                        <%= Number(bet.totalOdds).toFixed(2) %>
                                    </td>

                                    <td>
                                        ₦<%= Number(bet.potentialWin).toLocaleString() %>
                                    </td>

                                    <td>

                                        <span class="status <%= bet.status %>">
                                            <%= bet.status %>
                                        </span>

                                    </td>

                                    <td>

                                        <%= new Date(
                                            bet.createdAt
                                        ).toLocaleString() %>

                                    </td>

                                    <td>

                                        <a
                                            href="/admin/bets/<%= bet._id %>"
                                            class="view-btn"
                                        >
                                            View
                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </div>

    </main>

</div>

</body>

</html>